                                         {
                                             "id":  "component-8cfd558b19",
                                             "type":  "ft_document_info",
                                             "data":  {
                                                          "eyebrow":  "DOBRZE WIEDZIEĆ",
                                                          "heading":  "Akta wojskowe — co ustalić przed wizytą?",
                                                          "text":  "Dokumenty wojskowe mogą mieć różne wymagania zależnie od jednostki i celu dokumentacji. Najbezpieczniej zabrać aktualną instrukcję z WCR lub właściwej instytucji.",
                                                          "more":  "Jeśli wymagany jest plik cyfrowy albo określony ubiór, zgłoś to przed wykonaniem zdjęcia. Przygotujemy wariant zgodny z przekazanymi parametrami.",
                                                          "alertHeading":  "Informacje instytucji",
                                                          "alert":  "Wymagania mogą się zmieniać. Przed złożeniem dokumentów sprawdź aktualną procedurę i adres właściwej jednostki."
                                                      }
                                         }
                                     ],
                                     [
                                         {
                                             "id":  "component-68215e828c",
                                             "type":  "ft_document_faq",
                                             "data":  {
                                                          "eyebrow":  "NAJCZĘSTSZE PYTANIA",
                                                          "heading":  "O co pytacie przed zdjęciem do akt wojskowych?",
                                                          "items":  [
                                                                        {
                                                                            "question":  "Czy każde zdjęcie wojskowe ma ten sam format?",
                                                                            "answer":  "Nie. Wymiar, proporcje i liczba odbitek mogą zależeć od dokumentu oraz właściwej jednostki. Przynieś aktualną instrukcję."
                                                                        },
                                                                        {
                                                                            "question":  "Czy mogę zamówić sam plik cyfrowy?",
                                                                            "answer":  "Tak, jeśli procedura przyjmuje pliki. Przygotujemy go według podanych parametrów."
                                                                        },
                                                                        {
                                                                            "question":  "Czy muszę przyjść w mundurze?",
                                                                            "answer":  "Tylko jeśli wymaga tego instrukcja właściwej jednostki. W przeciwnym razie wybierz schludny, jednolity strój."
                                                                        },
                                                                        {
                                                                            "question":  "Czy mogę mieć okulary?",
                                                                            "answer":  "Tak, jeśli oczy są dobrze widoczne, oprawki nie zasłaniają brwi, a szkła nie odbijają światła."
                                                                        },
                                                                        {
                                                                            "question":  "Czy trzeba się umówić?",
                                                                            "answer":  "Przed przyjazdem zadzwoń lub napisz na WhatsApp i potwierdź dostępność oraz wymagany wariant."
                                                                        },
                                                                        {
                                                                            "question":  "Ile trwa wykonanie zdjęcia?",
                                                                            "answer":  "Sama wizyta zwykle zajmuje około 15 minut, zależnie od liczby ujęć i wybranego wariantu."
                                                                        }
                                                                    ]
                                                      }
