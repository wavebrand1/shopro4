                                     [
                                         {
                                             "id":  "component-8cfd558b19",
                                             "type":  "ft_document_info",
                                             "data":  {
                                                          "eyebrow":  "DOBRZE WIEDZIEĆ",
                                                          "heading":  "Dyplom — co ustalić przed wizytą?",
                                                          "text":  "Szkoła lub uczelnia może wymagać własnego wymiaru, tła, rozdzielczości albo sposobu przesłania zdjęcia. Najbezpieczniej zabrać aktualną instrukcję z sekretariatu lub dziekanatu.",
                                                          "more":  "Jeżeli zdjęcie będzie używane podczas uroczystości, sprawdź także, czy placówka wymaga konkretnego stroju lub terminu wykonania. Przygotujemy wariant zgodny z przekazanymi wytycznymi.",
                                                          "alertHeading":  "Informacje placówki",
                                                          "alert":  "Wymagania mogą się różnić między szkołami i uczelniami. Przed zamówieniem sprawdź aktualną instrukcję organizatora dyplomu."
                                                      }
                                         }
                                     ],
                                     [
                                         {
                                             "id":  "component-68215e828c",
                                             "type":  "ft_document_faq",
                                             "data":  {
                                                          "eyebrow":  "NAJCZĘSTSZE PYTANIA",
                                                          "heading":  "O co pytacie przed zdjęciem do dyplomu?",
                                                          "items":  [
                                                                        {
                                                                            "question":  "Czy każda szkoła i uczelnia wymaga tego samego formatu?",
                                                                            "answer":  "Nie. Format, proporcje, liczba odbitek i sposób przekazania mogą być różne. Przynieś instrukcję sekretariatu lub dziekanatu."
                                                                        },
                                                                        {
                                                                            "question":  "Czy mogę zamówić sam plik cyfrowy?",
                                                                            "answer":  "Tak, jeśli placówka przyjmuje pliki. Przygotujemy go według wskazanych parametrów."
                                                                        },
                                                                        {
                                                                            "question":  "Czy zdjęcie może być wykonane w stroju galowym?",
                                                                            "answer":  "Tak, o ile instrukcja placówki nie wskazuje inaczej. Wybierz schludny strój, który odcina się od jasnego tła."
                                                                        },
                                                                        {
                                                                            "question":  "Czy mogę mieć okulary?",
                                                                            "answer":  "Tak, jeśli oczy są dobrze widoczne, oprawki nie zasłaniają brwi, a szkła nie odbijają światła."
                                                                        },
                                                                        {
                                                                            "question":  "Czy zdjęcie trzeba umówić?",
                                                                            "answer":  "Przed przyjazdem zadzwoń lub napisz na WhatsApp i potwierdź dostępność oraz wymagany wariant."
                                                                        },
                                                                        {
                                                                            "question":  "Czy przygotujecie zdjęcie na uroczystość wręczenia dyplomu?",
                                                                            "answer":  "Tak. Ustalimy wymagania placówki i przygotujemy odbitki lub plik w terminie potwierdzonym przed realizacją."
                                                                        }
                                                                    ]
                                                      }
                                         }
