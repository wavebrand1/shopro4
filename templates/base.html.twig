<!DOCTYPE html>
<html lang="{{ app.request.locale|default(shopro_setting('language', 'pl')) }}" dir="{{ shopro_language() ? shopro_language().direction : 'ltr' }}">
    <head>
        <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block meta %}{% if shopro_setting('meta_description') %}<meta name="description" content="{{ shopro_setting('meta_description') }}">{% endif %}{% if shopro_setting('meta_keywords') %}<meta name="keywords" content="{{ shopro_setting('meta_keywords') }}">{% endif %}{% endblock %}
    {% block structured_data %}{% include 'cms/seo/_structured_data.html.twig' %}{% endblock %}
        <title>{% block title %}{{ shopro_setting('site_name', 'Shopro 4.0') }}{% endblock %}</title>
        {# A favicon must always be rendered.  A site may intentionally not have a
           custom upload yet, so fall back to the bundled Shopro asset instead of
           letting the browser use its generic document icon. #}
        {% set site_favicon = shopro_branding_asset(shopro_setting('favicon'), asset('branding/favicon.svg')) %}
        <link rel="icon" href="{{ site_favicon }}">
        {% set active_theme = shopro_active_front_theme() %}
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            {% if not (app.request.pathInfo starts with '/admin') and active_theme.frontStylesheet %}<link rel="stylesheet" href="{{ active_theme.frontStylesheet }}">{% endif %}
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('front') }}{% endblock %}
            {% if not (app.request.pathInfo starts with '/admin') and active_theme.frontJavascript %}<script src="{{ active_theme.frontJavascript }}" defer></script>{% endif %}
            {% set ga_id = shopro_setting('analytics_measurement_id') %}{% if ga_id and not shopro_setting('analytics_consent_required', true) and not (app.request.pathInfo starts with '/admin') %}<script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_id|url_encode }}"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',{{ ga_id|json_encode|raw }},{anonymize_ip:true});</script>{% endif %}
        {% endblock %}
    </head>
    <body class="front-theme--{{ shopro_setting('theme', 'modernize') }} theme-variant--{{ shopro_setting('theme_variant', 'blue') }} {% block body_class %}{% endblock %}">
        {% block body %}{% endblock %}
        {% if shopro_setting('eu_cookie', true) and not (app.request.pathInfo starts with '/admin') %}
            <aside class="cookie-consent" data-cookie-consent data-measurement-id="{{ shopro_setting('analytics_measurement_id') }}" hidden aria-label="Ustawienia prywatności">
                <div><strong>Twoja prywatność</strong><p>Używamy niezbędnych plików cookie. Analitykę uruchomimy wyłącznie po Twojej zgodzie.</p></div>
                <div class="cookie-consent__actions"><button type="button" class="modern-button" data-cookie-reject>Tylko niezbędne</button><button type="button" class="modern-button modern-button--primary" data-cookie-accept>Akceptuję</button></div>
            </aside>
        {% endif %}
        {% block page_javascript %}{% endblock %}
    </body>
</html>
