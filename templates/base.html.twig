<!DOCTYPE html>
<html lang="{{ app.request.locale|default(shopro_setting('language', 'pl')) }}" dir="{{ shopro_language() ? shopro_language().direction : 'ltr' }}">
    <head>
        <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block meta %}{% if shopro_setting('meta_description') %}<meta name="description" content="{{ shopro_setting('meta_description') }}">{% endif %}{% if shopro_setting('meta_keywords') %}<meta name="keywords" content="{{ shopro_setting('meta_keywords') }}">{% endif %}{% endblock %}
    {% block structured_data %}{% include 'cms/seo/_structured_data.html.twig' %}{% endblock %}
        <title>{% block title %}{{ shopro_setting('site_name', 'Shopro 4.0') }}{% endblock %}</title>
        {# A favicon must always be rendered.  A site may intentionally not have a
           custom upload yet, so fall back to the bundled Shopro asset instead of
           letting the browser use its generic document icon. #}
        {% set site_favicon = shopro_branding_asset(shopro_setting('favicon'), asset('branding/favicon.svg')) %}
        <link rel="icon" href="{{ site_favicon }}">
        {% set active_theme = shopro_active_front_theme() %}
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            {% if not (app.request.pathInfo starts with '/admin') and active_theme.frontStylesheet %}<link rel="stylesheet" href="{{ active_theme.frontStylesheet }}">{% endif %}
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('front') }}{% endblock %}
            {% if not (app.request.pathInfo starts with '/admin') and active_theme.frontJavascript %}<script src="{{ active_theme.frontJavascript }}" defer></script>{% endif %}
        {% endblock %}
    </head>
    <body class="front-theme--{{ shopro_setting('theme', 'modernize') }} theme-variant--{{ shopro_setting('theme_variant', 'blue') }} {% block body_class %}{% endblock %}">
        {% block body %}{% endblock %}
        {% if shopro_setting('eu_cookie', true) and not (app.request.pathInfo starts with '/admin') %}
            <aside class="cookie-consent" data-cookie-consent data-measurement-id="{{ shopro_setting('analytics_measurement_id') }}" data-analytics-consent-required="{{ shopro_setting('analytics_consent_required', true) ? 'true' : 'false' }}" hidden aria-labelledby="cookie-consent-title">
                <div class="cookie-consent__intro">
                    <strong id="cookie-consent-title">{{ shopro_trans('cookie.title') }}</strong>
                    <p>{{ shopro_trans('cookie.lead') }}</p>
                </div>
                <div class="cookie-consent__actions">
                    <button type="button" class="cookie-consent__button cookie-consent__button--secondary" data-cookie-reject>{{ shopro_trans('cookie.reject_optional') }}</button>
                    <button type="button" class="cookie-consent__button cookie-consent__button--secondary" data-cookie-settings>{{ shopro_trans('cookie.settings') }}</button>
                    <button type="button" class="cookie-consent__button cookie-consent__button--primary" data-cookie-accept>{{ shopro_trans('cookie.accept_all') }}</button>
                </div>
                <div class="cookie-consent__preferences" data-cookie-preferences hidden role="dialog" aria-label="{{ shopro_trans('cookie.settings') }}">
                    <div class="cookie-consent__categories">
                        <label class="cookie-consent__category"><input type="checkbox" checked disabled><span><b>{{ shopro_trans('cookie.necessary') }}</b><small>{{ shopro_trans('cookie.necessary_help') }}</small></span><em>{{ shopro_trans('cookie.necessary_always') }}</em></label>
                        <label class="cookie-consent__category"><input type="checkbox" data-cookie-category="preferences"><span><b>{{ shopro_trans('cookie.preferences') }}</b><small>{{ shopro_trans('cookie.preferences_help') }}</small></span></label>
                        <label class="cookie-consent__category"><input type="checkbox" data-cookie-category="analytics"><span><b>{{ shopro_trans('cookie.analytics') }}</b><small>{{ shopro_trans('cookie.analytics_help') }}</small></span></label>
                        <label class="cookie-consent__category"><input type="checkbox" data-cookie-category="marketing"><span><b>{{ shopro_trans('cookie.marketing') }}</b><small>{{ shopro_trans('cookie.marketing_help') }}</small></span></label>
                    </div>
                    <div class="cookie-consent__preferences-actions"><button type="button" class="cookie-consent__button cookie-consent__button--primary" data-cookie-save>{{ shopro_trans('cookie.save_settings') }}</button></div>
                </div>
            </aside>
        {% endif %}
        {% block page_javascript %}{% endblock %}
    </body>
</html>
