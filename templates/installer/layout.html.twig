<!doctype html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>{% block title %}Instalacja Shopro 4.0{% endblock %}</title>
    <style>
        :root{color-scheme:light;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#17243c;background:#f3f6fb}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 12% 10%,rgba(93,135,255,.12),transparent 28rem),#f3f6fb}.install-shell{width:min(980px,calc(100% - 32px));margin:45px auto}.install-brand{display:flex;align-items:center;gap:13px;margin-bottom:28px;font-size:1.2rem;font-weight:850}.install-brand i{display:grid;width:43px;height:43px;border-radius:13px;background:#5d87ff;color:#fff;font-style:normal;place-items:center;box-shadow:0 10px 25px rgba(93,135,255,.3)}.install-card{overflow:hidden;border:1px solid #dfe6f0;border-radius:22px;background:#fff;box-shadow:0 25px 70px rgba(31,48,76,.09)}.install-progress{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid #e8edf4;background:#fbfcfe}.install-progress span{padding:17px 12px;color:#8a98ad;font-size:.72rem;font-weight:750;text-align:center}.install-progress span.is-active{color:#4f76ec;background:#eef3ff}.install-content{padding:clamp(28px,6vw,58px)}.install-kicker{margin:0 0 8px;color:#5d87ff;font-size:.7rem;font-weight:850;letter-spacing:.13em}.install-content h1{margin:0;color:#17243c;font-size:clamp(2rem,5vw,3rem);letter-spacing:-.05em}.install-lead{max-width:700px;margin:12px 0 34px;color:#74839a;line-height:1.65}.install-checks{display:grid;gap:10px}.install-check{display:grid;grid-template-columns:36px 1fr auto;align-items:center;gap:12px;padding:16px;border:1px solid #e3e9f2;border-radius:13px;background:#fbfcfe}.install-check i{display:grid;width:28px;height:28px;border-radius:50%;background:#dff7ec;color:#159563;font-style:normal;font-weight:900;place-items:center}.install-check.is-error i{background:#ffe7e8;color:#d64d57}.install-check.is-warning i{background:#fff3d9;color:#c38318}.install-check strong{display:block;font-size:.87rem}.install-check small{color:#8492a7}.install-form{display:grid;gap:30px}.install-section{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;padding:24px;border:1px solid #e2e8f1;border-radius:16px;background:#fbfcfe}.install-section h2,.install-section p{grid-column:1/-1}.install-section h2{margin:0;font-size:1.05rem}.install-section p{margin:-10px 0 2px;color:#8390a5;font-size:.78rem}.install-field{display:grid;gap:7px;color:#34435b;font-size:.78rem;font-weight:750}.install-field--full{grid-column:1/-1}.install-field input,.install-field select{width:100%;min-height:48px;padding:0 14px;border:1px solid #d8e0ec;border-radius:11px;outline:0;background:#fff;color:#17243c;font:inherit}.install-field input:focus,.install-field select:focus{border-color:#5d87ff;box-shadow:0 0 0 3px rgba(93,135,255,.12)}.install-help{color:#8795aa;font-size:.7rem;font-weight:500}.install-error{margin:0 0 25px;padding:16px 18px;border:1px solid #ffd1d5;border-radius:12px;background:#fff0f1;color:#b83f49;line-height:1.5}.install-actions{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:30px}.install-button{display:inline-flex;min-height:48px;padding:0 23px;border:0;border-radius:11px;align-items:center;justify-content:center;background:#5d87ff;color:#fff;font:inherit;font-size:.8rem;font-weight:800;text-decoration:none;cursor:pointer;box-shadow:0 10px 24px rgba(93,135,255,.25)}.install-button--ghost{border:1px solid #dbe3ef;background:#fff;color:#53637b;box-shadow:none}.install-button[aria-disabled=true]{pointer-events:none;opacity:.45}.install-complete{padding:25px;border:1px solid #dbe8e3;border-radius:15px;background:#f0fbf6}.install-complete h2{margin:0 0 8px;color:#167d58}.install-code{display:block;overflow:auto;margin-top:13px;padding:14px;border-radius:10px;background:#17243c;color:#edf3ff;font:12px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:nowrap}.install-summary{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:28px 0}.install-summary div{padding:18px;border:1px solid #e2e8f1;border-radius:12px;background:#fbfcfe}.install-summary small{display:block;margin-bottom:5px;color:#8a98ad}.install-summary strong{overflow-wrap:anywhere}@media(max-width:680px){.install-shell{margin:18px auto}.install-progress span{font-size:0}.install-progress span::before{content:attr(data-step);font-size:.75rem}.install-section{grid-template-columns:1fr}.install-field,.install-section h2,.install-section p{grid-column:1}.install-summary{grid-template-columns:1fr}.install-actions{align-items:stretch;flex-direction:column-reverse}.install-button{width:100%}}
    </style>
</head>
<body>
<main class="install-shell">
    <div class="install-brand"><i>S</i><span>Shopro <b style="color:#5d87ff">4.0</b></span></div>
    <section class="install-card">
        <nav class="install-progress" aria-label="Postęp instalacji">
            {% for number,label in {1:'Serwer',2:'Baza danych',3:'Konfiguracja',4:'Gotowe'} %}
                <span class="{{ step == number ? 'is-active' : '' }}" data-step="{{ number }}">{{ number }}. {{ label }}</span>
            {% endfor %}
        </nav>
        <div class="install-content">{% block body %}{% endblock %}</div>
    </section>
</main>
</body>
</html>
