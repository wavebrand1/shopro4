{% extends 'admin/layout.html.twig' %}{% block title %}Szablony e-mail — Shopro 4.0{% endblock %}{% block body %}<div class="modern-page-heading"><div><p class="modern-kicker">KONFIGURACJA</p><h1>Szablony wiadomości e-mail</h1><p>Wspólne szablony wiadomości systemowych i modułów.</p></div><a class="modern-button modern-button--primary" href="{{ path('admin_email_template_new') }}">+ Nowy szablon</a></div><section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Nazwa</th><th>Kod</th><th>Temat</th><th>Akcje</th></tr></thead><tbody>{% for item in templates %}<tr><td><strong>{{ item.name }}</strong></td><td><code>{{ item.code }}</code></td><td>{{ item.subject }}</td><td><a href="{{ path('admin_email_template_edit',{id:item.id}) }}">Edytuj</a></td></tr>{% else %}<tr><td colspan="4" class="empty">Brak szablonów.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
