{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('email_template.heading') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('language.configuration') }}</p><h1>{{ shopro_trans('email_template.heading') }}</h1><p>{{ shopro_trans('email_template.lead') }}</p></div><a class="modern-button modern-button--primary" href="{{ path('admin_email_template_new') }}">+ {{ shopro_trans('email_template.new') }}</a></div>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('email_template.name') }}</th><th>{{ shopro_trans('email_template.code') }}</th><th>{{ shopro_trans('newsletter.subject') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>{% for item in templates %}<tr><td><strong>{{ item.name }}</strong></td><td><code>{{ item.code }}</code></td><td>{{ item.subject }}</td><td><a href="{{ path('admin_email_template_edit',{id:item.id}) }}">{{ shopro_trans('common.edit') }}</a></td></tr>{% else %}<tr><td colspan="4" class="empty">{{ shopro_trans('email_template.empty') }}</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
