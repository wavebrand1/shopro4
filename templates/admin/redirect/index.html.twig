{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('redirect.heading') }} — Shopro 4.0{% endblock %}
{% block body %}<div class="modern-page-heading"><div><p class="modern-kicker">SEO</p><h1>{{ shopro_trans('redirect.heading') }}</h1><p>{{ shopro_trans('redirect.lead') }}</p></div><a class="modern-button modern-button--primary" href="{{ path('admin_url_redirect_new') }}">+ {{ shopro_trans('redirect.new') }}</a></div>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('redirect.source') }}</th><th>{{ shopro_trans('redirect.target') }}</th><th>{{ shopro_trans('redirect.type') }}</th><th>{{ shopro_trans('redirect.usage') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>{% for redirect in redirects %}<tr><td><code>{{ redirect.sourcePath }}</code></td><td><code>{{ redirect.targetPath }}</code></td><td>{{ redirect.permanent ? '301' : '302' }}</td><td>{{ redirect.hits }}{% if redirect.lastUsedAt %}<small class="table-muted">{{ redirect.lastUsedAt|date('Y-m-d H:i') }}</small>{% endif %}</td><td><span class="status status--{{ redirect.active ? 'published' : 'draft' }}">{{ shopro_trans(redirect.active ? 'common.active' : 'common.inactive') }}</span></td><td><div class="table-actions"><a href="{{ path('admin_url_redirect_edit',{id:redirect.id}) }}">{{ shopro_trans('common.edit') }}</a><form method="post" action="{{ path('admin_url_redirect_delete',{id:redirect.id}) }}" onsubmit="return confirm('{{ shopro_trans('redirect.delete_confirm') }}')"><input type="hidden" name="_token" value="{{ csrf_token('delete-redirect-'~redirect.id) }}"><button class="link-danger">{{ shopro_trans('common.delete') }}</button></form></div></td></tr>{% else %}<tr><td colspan="6" class="empty">{{ shopro_trans('redirect.empty') }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
