{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans(redirect.id ? 'redirect.edit' : 'redirect.new') }} — Shopro 4.0{% endblock %}
{% block body %}<div class="modern-page-heading"><div><p class="modern-kicker">SEO</p><h1>{{ shopro_trans(redirect.id ? 'redirect.edit' : 'redirect.new') }}</h1><p>{{ shopro_trans('redirect.form_help') }}</p></div><a class="modern-button" href="{{ path('admin_url_redirect_index') }}">← {{ shopro_trans('common.back') }}</a></div>{{ form_start(form) }}<section class="modern-card"><div class="cms-card-body">{{ form_errors(form) }}{{ form_row(form.sourcePath) }}{{ form_row(form.targetPath) }}<div class="component-fields component-fields--two">{{ form_row(form.permanent) }}{{ form_row(form.active) }}</div></div></section><div class="form-actions"><a class="modern-button" href="{{ path('admin_url_redirect_index') }}">{{ shopro_trans('common.cancel') }}</a><button class="modern-button modern-button--primary">{{ shopro_trans('common.save') }}</button></div>{{ form_end(form) }}{% endblock %}
