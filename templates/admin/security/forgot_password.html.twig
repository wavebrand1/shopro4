{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('auth.forgot_password') }} — Shopro 4.0{% endblock %}
{% block body %}<section class="modern-login-card"><div class="modern-login-brand"><span class="modern-logo">S</span><span>Shopro <b>4.0</b></span></div><p class="modern-kicker">{{ shopro_trans('auth.admin_panel') }}</p><h1>{{ shopro_trans('auth.forgot_password') }}</h1><p class="modern-login-lead">{{ shopro_trans('auth.forgot_password_help') }}</p>{% if sent %}<div class="flash flash--success">{{ shopro_trans('auth.forgot_password_sent') }}</div>{% else %}<form method="post" class="admin-form modern-login-form"><label>{{ shopro_trans('auth.identifier') }}<input type="text" name="identifier" required autofocus autocomplete="username"></label><input type="hidden" name="_token" value="{{ csrf_token('password-forgot') }}"><button class="modern-button modern-button--primary modern-button--wide">{{ shopro_trans('auth.send_reset_link') }}</button></form>{% endif %}<a class="modern-login-footer" href="{{ path('admin_login') }}">← {{ shopro_trans('auth.back_to_login') }}</a></section>{% endblock %}
