{% extends 'admin/layout.html.twig' %}
{% block title %}Logowanie — Shopro 4.0{% endblock %}
{% block body %}
<section class="modern-login-card">
    <div class="modern-login-brand"><span class="modern-logo">S</span><span>Shopro <b>4.0</b></span></div>
    <p class="modern-kicker">PANEL ADMINISTRACYJNY</p>
    <h1>Witaj ponownie</h1>
    <p class="modern-login-lead">Zaloguj się, aby zarządzać witryną.</p>
    {% if error %}<div class="flash flash--error">Nieprawidłowy e-mail lub hasło.</div>{% endif %}
    <form method="post" class="admin-form modern-login-form">
        <label>Login lub adres e-mail<input type="text" name="_username" value="{{ last_username }}" required autofocus autocomplete="username" placeholder="admin lub admin@example.pl"></label>
        <label>Hasło<input type="password" name="_password" required autocomplete="current-password" placeholder="Wprowadź hasło"></label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="modern-button modern-button--primary modern-button--wide" type="submit">Zaloguj się</button>
    </form>
    <small class="modern-login-footer">Shopro 4.0 · Środowisko developerskie</small>
</section>
{% endblock %}
