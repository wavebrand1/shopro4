{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('auth.set_new_password') }} — Shopro 4.0{% endblock %}
{% block body %}<section class="modern-login-card"><div class="modern-login-brand"><span class="modern-logo">S</span><span>Shopro <b>4.0</b></span></div><p class="modern-kicker">{{ shopro_trans('auth.admin_panel') }}</p><h1>{{ shopro_trans('auth.set_new_password') }}</h1>{% if invalid %}<div class="flash flash--error">{{ shopro_trans('auth.reset_link_invalid') }}</div><a class="modern-button modern-button--primary modern-button--wide" href="{{ path('admin_password_forgot') }}">{{ shopro_trans('auth.request_new_link') }}</a>{% else %}<p class="modern-login-lead">{{ shopro_trans('auth.set_new_password_help') }}</p>{% if error %}<div class="flash flash--error">{{ shopro_trans(error) }}</div>{% endif %}<form method="post" class="admin-form modern-login-form"><label>{{ shopro_trans('auth.new_password') }}<input type="password" name="password" required minlength="12" autocomplete="new-password"></label><label>{{ shopro_trans('auth.repeat_password') }}<input type="password" name="password_confirmation" required minlength="12" autocomplete="new-password"></label><input type="hidden" name="_token" value="{{ csrf_token('password-reset-'~token) }}"><button class="modern-button modern-button--primary modern-button--wide">{{ shopro_trans('auth.save_new_password') }}</button></form>{% endif %}</section>{% endblock %}
