{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans(user.id ? 'users.edit' : 'users.new') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('users.access_management') }}</p><h1>{{ shopro_trans(user.id ? 'users.edit' : 'users.new') }}</h1><p>{{ shopro_trans('users.unique_help') }}</p></div><a class="modern-button" href="{{ path('admin_user_index') }}">← {{ shopro_trans('common.back') }}</a></div>
{{ form_start(form,{attr:{class:'admin-form'}}) }}<section class="modern-card"><div class="modern-card__heading"><div><h2>{{ shopro_trans('users.account_data') }}</h2><p>{{ shopro_trans('users.password_help') }}</p></div></div><div class="cms-card-body"><div class="component-fields">{{ form_row(form.username) }}{{ form_row(form.email) }}{{ form_row(form.firstName) }}{{ form_row(form.lastName) }}{{ form_row(form.plainPassword) }}</div><div class="cms-option-grid">{{ form_row(form.active) }}{{ form_row(form.newsletter) }}{{ form_row(form.apiEnabled) }}</div>{{ form_row(form.apiScopes) }}</div></section><div class="cms-sticky-actions"><a class="modern-button" href="{{ path('admin_user_index') }}">{{ shopro_trans('common.cancel') }}</a><button class="modern-button modern-button--primary">{{ shopro_trans('users.save') }}</button></div>{{ form_end(form) }}
{% if user.id %}<section class="modern-card settings-card"><div class="modern-card__heading"><div><h2>{{ shopro_trans('users.api_key') }}</h2><p>{{ shopro_trans('users.api_help') }}</p></div></div><div class="cms-card-body">{% for token in app.flashes('api_token') %}<div class="api-token-reveal"><code>{{ token }}</code><button type="button" class="modern-button" onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent)">{{ shopro_trans('users.copy') }}</button></div>{% endfor %}<p>{{ user.apiTokenPrefix ? shopro_trans('users.active_token') ~ ' ' ~ user.apiTokenPrefix ~ '…' : shopro_trans('users.no_token') }}</p><form method="post" action="{{ path('admin_user_api_token',{id:user.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('api-token-' ~ user.id) }}"><button class="modern-button modern-button--primary" name="action" value="rotate">{{ shopro_trans(user.apiTokenPrefix ? 'users.rotate_token' : 'users.generate_token') }}</button>{% if user.apiTokenPrefix %}<button class="modern-button" name="action" value="revoke">{{ shopro_trans('users.revoke') }}</button>{% endif %}</form></div></section>{% endif %}
{% endblock %}
