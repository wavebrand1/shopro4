{% extends 'admin/layout.html.twig' %}
{% block title %}{{ user.id ? 'Edycja użytkownika' : 'Nowy użytkownik' }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">ZARZĄDZANIE DOSTĘPEM</p><h1>{{ user.id ? 'Edytuj użytkownika' : 'Nowy użytkownik' }}</h1><p>Login i e-mail muszą być unikalne.</p></div><a class="modern-button" href="{{ path('admin_user_index') }}">← Wróć do listy</a></div>
{{ form_start(form,{attr:{class:'admin-form'}}) }}<section class="modern-card"><div class="modern-card__heading"><div><h2>Dane konta</h2><p>Puste nowe hasło pozostawia obecne hasło bez zmian.</p></div></div><div class="cms-card-body"><div class="component-fields">{{ form_row(form.username) }}{{ form_row(form.email) }}{{ form_row(form.firstName) }}{{ form_row(form.lastName) }}{{ form_row(form.plainPassword) }}</div><div class="cms-option-grid">{{ form_row(form.active) }}{{ form_row(form.newsletter) }}{{ form_row(form.apiEnabled) }}</div>{{ form_row(form.apiScopes) }}</div></section><div class="cms-sticky-actions"><a class="modern-button" href="{{ path('admin_user_index') }}">Anuluj</a><button class="modern-button modern-button--primary">Zapisz użytkownika</button></div>{{ form_end(form) }}
{% if user.id %}<section class="modern-card settings-card"><div class="modern-card__heading"><div><h2>Klucz API użytkownika</h2><p>Token ma uprawnienia zaznaczone powyżej. W bazie przechowywany jest wyłącznie jego skrót.</p></div></div><div class="cms-card-body">{% for token in app.flashes('api_token') %}<div class="api-token-reveal"><code>{{ token }}</code><button type="button" class="modern-button" onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent)">Kopiuj</button></div>{% endfor %}<p>{{ user.apiTokenPrefix ? 'Aktywny token: ' ~ user.apiTokenPrefix ~ '…' : 'Brak wygenerowanego tokenu.' }}</p><form method="post" action="{{ path('admin_user_api_token',{id:user.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('api-token-' ~ user.id) }}"><button class="modern-button modern-button--primary" name="action" value="rotate">{{ user.apiTokenPrefix ? 'Wygeneruj nowy token' : 'Wygeneruj token' }}</button>{% if user.apiTokenPrefix %}<button class="modern-button" name="action" value="revoke">Unieważnij</button>{% endif %}</form></div></section>{% endif %}
{% endblock %}
