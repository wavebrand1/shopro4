{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('users.heading') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('users.access_management') }}</p><h1>{{ shopro_trans('users.heading') }}</h1><p>{{ shopro_trans('users.lead') }}</p></div><a class="modern-button modern-button--primary" href="{{ path('admin_user_new') }}">+ {{ shopro_trans('users.new') }}</a></div>
<section class="modern-card modern-table-card"><div class="modern-card__heading"><form method="get" class="admin-user-search"><input name="q" value="{{ query }}" placeholder="{{ shopro_trans('users.search_placeholder') }}"><button class="modern-button">{{ shopro_trans('common.search') }}</button></form></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('users.user') }}</th><th>{{ shopro_trans('users.email') }}</th><th>{{ shopro_trans('users.created_at') }}</th><th>{{ shopro_trans('users.last_login') }}</th><th>{{ shopro_trans('users.newsletter') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>
{% for user in users %}<tr><td><div class="page-cell"><span class="page-cell__icon">{{ user.username|first|upper }}</span><div><strong>{{ user.displayName }}</strong><small>{{ user.username }}</small></div></div></td><td>{{ user.email }}</td><td><span class="date-cell">{{ shopro_date(user.createdAt) }}<small>{{ shopro_date(user.createdAt, 'time') }}</small></span></td><td>{% if user.lastLoginAt %}<span class="date-cell">{{ shopro_date(user.lastLoginAt) }}<small>{{ shopro_date(user.lastLoginAt, 'time') }}</small></span>{% else %}—{% endif %}</td><td>{{ shopro_trans(user.newsletter ? 'common.yes' : 'common.no') }}</td><td><span class="status status--{{ user.active ? 'published' : 'draft' }}"><i></i>{{ shopro_trans(user.active ? 'common.active' : 'common.inactive') }}</span></td><td class="actions"><a href="{{ path('admin_user_edit',{id:user.id}) }}">{{ shopro_trans('common.edit') }}</a><form method="post" action="{{ path('admin_user_delete',{id:user.id}) }}" onsubmit="return confirm('{{ shopro_trans('users.delete_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('delete-user-'~user.id) }}"><button>{{ shopro_trans('common.delete') }}</button></form></td></tr>{% else %}<tr><td colspan="7" class="empty">{{ shopro_trans('users.empty') }}</td></tr>{% endfor %}
</tbody></table></div>{% include 'admin/_pagination.html.twig' with {query_params:{q:query}} %}</section>
{% endblock %}
