{% extends 'admin/layout.html.twig' %}{% block title %}Tłumaczenia strony — Shopro 4.0{% endblock %}{% block body %}<div class="modern-page-heading"><div><p class="modern-kicker">WIELOJĘZYCZNOŚĆ</p><h1>{{ page.title }}</h1><p>Wersje językowe są powiązane z jednym dokumentem strony.</p></div><a class="modern-button" href="{{ path('admin_page_index') }}">← Podstrony</a></div><section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Język</th><th>Adres</th><th>Status</th><th>Akcja</th></tr></thead><tbody>{% for language in languages %}{% set item=translations[language.id]|default(null) %}<tr><td><strong>{{ language.name }}</strong></td><td>{{ item?('/'~language.code~'/'~item.slug):'—' }}</td><td>{{ item?(item.published?'Opublikowane':'Szkic'):'Brak tłumaczenia' }}</td><td><a href="{{ path('admin_page_translation_edit',{id:page.id,languageId:language.id}) }}">{{ item?'Edytuj':'Utwórz z wersji bazowej' }}</a></td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
