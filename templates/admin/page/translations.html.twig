{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('page.translation_versions') }} — Shopro 4.0{% endblock %}
{% block body %}<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('menu.multilingual') }}</p><h1>{{ page.title }}</h1><p>{{ shopro_trans('page.translation_versions_help') }}</p></div><a class="modern-button" href="{{ path('admin_page_index') }}">← {{ shopro_trans('pages.heading') }}</a></div><section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('language.language') }}</th><th>{{ shopro_trans('pages.url') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>{% for language in languages %}{% set item=translations[language.id]|default(null) %}<tr><td><strong>{{ language.name }}</strong></td><td>{{ item?('/'~language.code~'/'~item.slug):'—' }}</td><td>{{ item?(item.published?shopro_trans('page.published'):shopro_trans('page.draft')):shopro_trans('page.no_translation') }}</td><td><a href="{{ path('admin_page_translation_edit',{id:page.id,languageId:language.id}) }}">{{ shopro_trans(item?'common.edit':'page.create_from_base') }}</a></td></tr>{% else %}<tr><td colspan="4" class="empty">{{ shopro_trans('menu.no_languages') }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
