{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('pages.trash') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('admin.content_management') }}</p><h1>{{ shopro_trans('pages.trash') }}</h1><p>{{ shopro_trans('pages.trash_help') }}</p></div><a class="modern-button" href="{{ path('admin_page_index') }}">← {{ shopro_trans('pages.heading') }}</a></div>
<section class="modern-card modern-table-card">
<div class="modern-card__heading"><div><h2>{{ shopro_trans('pages.trash') }}</h2><p>{{ total }} {{ shopro_trans(total == 1 ? 'pages.item' : 'pages.items') }}</p></div></div>
<form class="admin-list-filters" method="get" action="{{ path('admin_page_trash') }}"><label><span>{{ shopro_trans('pages.search') }}</span><input type="search" name="q" value="{{ search }}" placeholder="{{ shopro_trans('pages.search_placeholder') }}"></label><button class="modern-button modern-button--primary" type="submit">{{ shopro_trans('common.filter') }}</button>{% if search %}<a class="modern-button" href="{{ path('admin_page_trash') }}">{{ shopro_trans('common.clear') }}</a>{% endif %}</form>
<form id="trash-bulk-form" method="post" action="{{ path('admin_page_trash_bulk_restore') }}" data-page-bulk><input type="hidden" name="_token" value="{{ csrf_token('bulk-restore-pages') }}"><input type="hidden" name="return_q" value="{{ search }}"><input type="hidden" name="return_page" value="{{ current_page }}"></form>
<div class="admin-bulk-actions" data-page-bulk-actions hidden><strong><span data-page-bulk-count>0</span> {{ shopro_trans('pages.selected') }}</strong><button class="modern-button modern-button--primary" type="submit" form="trash-bulk-form">{{ shopro_trans('pages.restore_selected') }}</button>{% if is_granted('ROLE_ADMIN') %}<button class="modern-button" type="submit" form="trash-bulk-form" formaction="{{ path('admin_page_trash_bulk_destroy') }}" name="_destroy_token" value="{{ csrf_token('bulk-destroy-pages') }}" onclick="return confirm('{{ shopro_trans('pages.bulk_destroy_confirm')|e('js') }}')">{{ shopro_trans('pages.destroy_selected') }}</button>{% endif %}</div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th class="table-select"><label class="ui-check ui-check--compact"><input type="checkbox" data-page-select-all aria-label="{{ shopro_trans('pages.select_all') }}"><span></span></label></th><th>{{ shopro_trans('pages.page') }}</th><th>{{ shopro_trans('pages.url') }}</th><th>{{ shopro_trans('pages.deleted_at') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>
{% for page in pages %}<tr><td class="table-select"><label class="ui-check ui-check--compact"><input type="checkbox" name="pages[]" value="{{ page.id }}" form="trash-bulk-form" data-page-select aria-label="{{ shopro_trans('pages.select_page') }} {{ page.title }}"><span></span></label></td><td><div class="page-cell"><span class="page-cell__icon">{{ page.title|first|upper }}</span><div><strong>{{ page.title }}</strong><small>ID: {{ page.id }}</small></div></div></td><td><code>/{{ page.slug }}</code></td><td>{{ shopro_date(page.deletedAt) }} {{ shopro_date(page.deletedAt, 'time') }}</td><td class="actions"><form method="post" action="{{ path('admin_page_restore',{id:page.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('restore-page-'~page.id) }}"><button>{{ shopro_trans('pages.restore') }}</button></form>{% if is_granted('ROLE_ADMIN') %}<form method="post" action="{{ path('admin_page_destroy',{id:page.id}) }}" onsubmit="return confirm('{{ shopro_trans('pages.destroy_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('destroy-page-'~page.id) }}"><button>{{ shopro_trans('pages.destroy') }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="empty">{{ shopro_trans(search ? 'pages.trash_no_results' : 'pages.trash_empty') }}</td></tr>{% endfor %}
</tbody></table></div>{% include 'admin/_pagination.html.twig' %}</section>
{% endblock %}
