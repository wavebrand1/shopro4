{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('pages.trash') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('admin.content_management') }}</p><h1>{{ shopro_trans('pages.trash') }}</h1><p>{{ shopro_trans('pages.trash_help') }}</p></div><a class="modern-button" href="{{ path('admin_page_index') }}">← {{ shopro_trans('pages.heading') }}</a></div>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('pages.page') }}</th><th>{{ shopro_trans('pages.url') }}</th><th>{{ shopro_trans('pages.deleted_at') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>
{% for page in pages %}<tr><td><div class="page-cell"><span class="page-cell__icon">{{ page.title|first|upper }}</span><div><strong>{{ page.title }}</strong><small>ID: {{ page.id }}</small></div></div></td><td><code>/{{ page.slug }}</code></td><td>{{ shopro_date(page.deletedAt) }} {{ shopro_date(page.deletedAt, 'time') }}</td><td class="actions"><form method="post" action="{{ path('admin_page_restore',{id:page.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('restore-page-'~page.id) }}"><button>{{ shopro_trans('pages.restore') }}</button></form>{% if is_granted('ROLE_ADMIN') %}<form method="post" action="{{ path('admin_page_destroy',{id:page.id}) }}" onsubmit="return confirm('{{ shopro_trans('pages.destroy_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('destroy-page-'~page.id) }}"><button>{{ shopro_trans('pages.destroy') }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="empty">{{ shopro_trans('pages.trash_empty') }}</td></tr>{% endfor %}
</tbody></table></div></section>
{% endblock %}
