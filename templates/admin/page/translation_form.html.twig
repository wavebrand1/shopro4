{% extends 'admin/layout.html.twig' %}{% block title %}Tłumaczenie {{ language.name }} — Shopro 4.0{% endblock %}{% block javascripts %}{{ importmap(['app','component-builder']) }}{% endblock %}{% block body %}<div class="modern-page-heading"><div><p class="modern-kicker">{{ language.code|upper }} · {{ language.name }}</p><h1>Tłumaczenie: {{ page.title }}</h1><p>Treść, SEO i układ Page Buildera dla tej wersji.</p></div><a class="modern-button" href="{{ path('admin_page_translation_index',{id:page.id}) }}">← Wersje</a></div>{{ form_start(form,{attr:{class:'admin-form admin-form--page'}}) }}<section class="modern-card"><div class="cms-card-body"><div class="modern-form-grid">{{ form_row(form.title) }}{{ form_row(form.slug) }}</div><div class="modern-form-grid">{{ form_row(form.caption) }}{{ form_row(form.seoTitle) }}</div><div class="modern-form-grid">{{ form_row(form.description) }}{{ form_row(form.canonical) }}</div>{{ form_row(form.published) }}</div></section><section class="modern-card cms-editor-card"><div class="modern-card__heading"><h2>Page Builder</h2></div><div class="cms-card-body">{{ form_widget(form.content) }}<div class="component-builder" data-component-builder data-project-field="page_translation_builderData"><aside class="component-builder__library"><button class="component-library-item" type="button" data-add-section><strong>Dodaj sekcję</strong></button>{% for type,label in {rich_text:'Edytor tekstu',hero:'Hero',feature_cards:'Karty funkcji',logo_bar:'Pasek marek',process:'Jak to działa',audience:'Dla kogo',cta:'CTA'} %}<button class="component-library-item" type="button" data-add-component="{{ type }}"><strong>{{ label }}</strong></button>{% endfor %}</aside><div class="component-builder__workspace"><div class="component-builder__empty" data-builder-empty><strong>Brak komponentów</strong></div><div class="component-builder__list" data-builder-list></div></div></div>{{ form_widget(form.builderData) }}{{ form_widget(form.builderCss) }}</div></section><div class="cms-sticky-actions"><button class="modern-button modern-button--primary">Zapisz tłumaczenie</button></div>{{ form_end(form) }}{% endblock %}
