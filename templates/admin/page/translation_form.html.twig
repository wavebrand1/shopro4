{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('page.translation') }} {{ language.name }} — Shopro 4.0{% endblock %}
{% block javascripts %}{% set active_theme = shopro_active_front_theme() %}{% if active_theme.builderJavascript %}<script src="{{ active_theme.builderJavascript }}"></script>{% endif %}{% for script in shopro_builder_editor_javascripts() %}<script src="{{ asset(script) }}"></script>{% endfor %}{{ importmap(['app','component-builder']) }}{% endblock %}
{% block body %}
<div class="modern-page-heading">
    <div><p class="modern-kicker">{{ language.code|upper }} · {{ language.name }}</p><h1>{{ shopro_trans('page.translation') }}: {{ page.title }}</h1><p>{{ shopro_trans('page.translation_help') }}</p></div>
    <a class="modern-button" href="{{ path('admin_page_translation_index',{id:page.id}) }}">← {{ shopro_trans('page.versions') }}</a>
</div>
<form id="copy-base-template-form" method="post" action="{{ path('admin_page_translation_copy_base',{id:page.id,languageId:language.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('copy-page-template-'~page.id~'-'~language.id) }}"></form>
{{ form_start(form,{attr:{class:'admin-form admin-form--page'}}) }}
<section class="modern-card"><div class="cms-card-body">
    <div class="modern-form-grid">{{ form_row(form.title) }}{{ form_row(form.slug) }}</div>
    <div class="modern-form-grid">{{ form_row(form.caption) }}{{ form_row(form.seoTitle) }}</div>
    <div class="modern-form-grid">{{ form_row(form.description) }}{{ form_row(form.canonical) }}</div>
    {{ form_row(form.published) }}
</div></section>
<section class="modern-card cms-editor-card">
    <div class="modern-card__heading"><div><h2>Page Builder</h2><p>{{ shopro_trans('page.copy_base_template_help') }}</p></div><button class="modern-button" type="submit" form="copy-base-template-form">{{ shopro_trans('page.copy_base_template') }}</button></div>
    <div class="cms-card-body">{{ form_widget(form.content) }}
        <div class="component-builder" data-component-builder data-project-field="page_translation_builderData" data-system-role-required="{{ page.requiresSystemRoleComponent ? 'true' : 'false' }}">
            <aside class="component-builder__library">
                <button class="component-library-item" type="button" data-add-section><strong>{{ shopro_trans('builder.add_section') }}</strong></button>
                {% for component in shopro_builder_components()|filter(component => not component.preset) %}
                    <button class="component-library-item" type="button" data-add-component="{{ component.type }}"><strong>{{ component.label starts with 'builder.' ? shopro_trans(component.label) : component.label }}</strong></button>
                {% endfor %}
            </aside>
            <div class="component-builder__workspace"><div class="component-builder__empty" data-builder-empty><strong>{{ shopro_trans('builder.empty') }}</strong></div><div class="component-builder__list" data-builder-list></div></div>
        </div>
        {{ form_widget(form.builderData) }}{{ form_widget(form.builderCss) }}
    </div>
</section>
<div class="cms-sticky-actions"><button class="modern-button modern-button--primary">{{ shopro_trans('page.save_translation') }}</button></div>
{{ form_end(form) }}
{% endblock %}
