{% extends 'admin/layout.html.twig' %}{% block title %}{{ shopro_trans('revision.heading') }} — Shopro 4.0{% endblock %}{% block body %}<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('admin.content_management') }}</p><h1>{{ shopro_trans('revision.heading') }}</h1><p>{{ page.title }} · {{ shopro_trans('revision.lead') }}</p></div><a class="modern-button" href="{{ path('admin_page_edit',{id:page.id}) }}">← {{ shopro_trans('revision.back_edit') }}</a></div><section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('revision.version') }}</th><th>{{ shopro_trans('revision.snapshot') }}</th><th>{{ shopro_trans('revision.changes') }}</th><th>{{ shopro_trans('revision.author') }}</th><th>{{ shopro_trans('common.created_at') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>{% for row in rows %}{% set revision=row.revision %}<tr><td><strong>#{{ revision.version }}</strong></td><td><strong>{{ revision.title }}</strong><small class="table-muted">/{{ revision.slug }} · {{ shopro_trans(revision.published ? 'page.published' : 'page.draft') }}</small></td><td><div class="revision-tags">{% for change in row.changes %}<span>{{ shopro_trans(change) }}</span>{% endfor %}</div></td><td>{{ revision.createdBy ?: '—' }}</td><td>{{ shopro_date(revision.createdAt) }}<small class="table-muted">{{ shopro_date(revision.createdAt,'time') }}</small></td><td class="actions"><a href="{{ path('admin_page_revision_show',{id:page.id,revisionId:revision.id}) }}">{{ shopro_trans('revision.inspect') }}</a><form method="post" action="{{ path('admin_page_revision_restore',{id:page.id,revisionId:revision.id}) }}" onsubmit="return confirm('{{ shopro_trans('revision.restore_confirm') }}')"><input type="hidden" name="_token" value="{{ csrf_token('restore-revision-'~revision.id) }}"><button>{{ shopro_trans('revision.restore') }}</button></form></td></tr>{% else %}<tr><td colspan="6" class="empty">{{ shopro_trans('revision.empty') }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
