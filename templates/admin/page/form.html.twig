{% extends 'admin/layout.html.twig' %}
{% block title %}{{ page.id ? 'Edycja podstrony' : 'Nowa podstrona' }} — Shopro 4.0{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('vendor/grapesjs/dist/css/grapes.min.css') }}">{% endblock %}
{% block javascripts %}{{ importmap(['app', 'page-builder']) }}{% endblock %}
{% block body %}
<div class="modern-page-heading">
    <div><p class="modern-kicker">ZARZĄDZANIE TREŚCIĄ</p><h1>{{ page.id ? 'Edytuj podstronę' : 'Nowa podstrona' }}</h1><p>Formularz odwzorowuje ustawienia podstrony ze starego CMS.</p></div>
    <a class="modern-button" href="{{ path('admin_page_index') }}">← Wróć do listy</a>
</div>
{{ form_start(form, {attr: {class: 'admin-form admin-form--page'}}) }}
<section class="modern-card modern-form-card">
    <div class="modern-card__heading"><div><h2>Podstawowe informacje</h2><p>Tytuł, adres i sposób udostępniania strony.</p></div></div>
    <div class="cms-card-body">
    <div class="modern-form-grid">{{ form_row(form.title) }}{{ form_row(form.slug) }}</div>
    <div class="modern-form-grid">{{ form_row(form.caption) }}{{ form_row(form.seoTitle) }}</div>
    <div class="modern-form-grid">{{ form_row(form.access) }}{{ form_row(form.canonical) }}</div>
    <div class="cms-option-grid">{{ form_row(form.published) }}{{ form_row(form.follow) }}</div>
    </div>
</section>
<section class="modern-card modern-form-card cms-editor-card">
    <div class="modern-card__heading"><div><h2>Live edytor</h2><p>Buduj stronę z sekcji i komponentów. HTML jest generowany automatycznie przy zapisie.</p></div><div class="builder-device-buttons"><button type="button" data-builder-device="Desktop">Desktop</button><button type="button" data-builder-device="Tablet">Tablet</button><button type="button" data-builder-device="Mobile portrait">Telefon</button></div></div>
    <div class="cms-card-body">
    <div class="shopro-builder" data-shopro-builder data-content-field="page_content" data-project-field="page_builderData" data-css-field="page_builderCss" data-style-url="{{ asset('styles/app.css') }}">
        <aside class="shopro-builder__blocks"><strong>Elementy</strong><div data-builder-blocks></div></aside>
        <div class="shopro-builder__canvas" data-builder-canvas></div>
    </div>
    <details class="builder-html-fallback"><summary>Zaawansowane: wygenerowany HTML</summary>{{ form_row(form.content) }}</details>
    {{ form_widget(form.builderData) }}{{ form_widget(form.builderCss) }}
    {{ form_row(form.description) }}
    </div>
</section>
<details class="modern-card modern-form-card cms-advanced" {{ not page.id ? 'open' : '' }}>
    <summary><span><strong>Ustawienia zaawansowane</strong><small>SEO, role systemowe i kod strony</small></span><b>+</b></summary>
    <div class="cms-advanced__content">
        <h3>Role strony</h3><p class="form-help">Każda rola systemowa oraz strona główna i 404 mogą być przypisane tylko do jednej podstrony.</p>
        <div class="cms-option-grid cms-option-grid--roles">
            {{ form_row(form.homePage) }}{{ form_row(form.errorPage) }}{{ form_row(form.adminOnly) }}
            {{ form_row(form.loginPage) }}{{ form_row(form.activationPage) }}{{ form_row(form.accountPage) }}
            {{ form_row(form.registrationPage) }}{{ form_row(form.searchPage) }}{{ form_row(form.sitemapPage) }}
            {{ form_row(form.profilePage) }}{{ form_row(form.termsPage) }}
        </div>
        <h3>SEO i kod</h3>
        <div class="modern-form-grid">{{ form_row(form.keywords) }}{{ form_row(form.meta) }}</div>
        {{ form_row(form.javascript) }}
        <div class="cms-module-placeholder"><strong>Moduł podstrony</strong><span>Obsługa modułów i członkostw zostanie podłączona wraz z migracją systemu modułowego.</span></div>
    </div>
</details>
<div class="modern-form-actions cms-sticky-actions"><a class="modern-button" href="{{ path('admin_page_index') }}">Anuluj</a><button class="modern-button modern-button--primary" type="submit">Zapisz podstronę</button></div>
{{ form_end(form) }}
{% endblock %}
