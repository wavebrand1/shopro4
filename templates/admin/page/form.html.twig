{% extends 'admin/layout.html.twig' %}
{% block title %}{{ page.id ? 'Edycja podstrony' : 'Nowa podstrona' }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading">
    <div><p class="modern-kicker">ZARZĄDZANIE TREŚCIĄ</p><h1>{{ page.id ? 'Edytuj podstronę' : 'Nowa podstrona' }}</h1><p>{{ page.id ? 'Zaktualizuj treść i ustawienia publikacji.' : 'Utwórz nową zawartość dla swojej witryny.' }}</p></div>
    <a class="modern-button" href="{{ path('admin_page_index') }}">← Wróć do listy</a>
</div>
<section class="modern-card modern-form-card">
    <div class="modern-card__heading"><div><h2>Dane podstrony</h2><p>Pola oznaczone gwiazdką są wymagane.</p></div></div>
    {{ form_start(form, {attr: {class: 'admin-form admin-form--page'}}) }}
        <div class="modern-form-grid">{{ form_row(form.title) }}{{ form_row(form.slug) }}</div>
        {{ form_row(form.content) }}
        <div class="modern-publish-row">{{ form_row(form.published) }}<p>Opublikowana podstrona będzie dostępna pod wskazanym adresem URL.</p></div>
        <div class="modern-form-actions"><a class="modern-button" href="{{ path('admin_page_index') }}">Anuluj</a><button class="modern-button modern-button--primary" type="submit">Zapisz podstronę</button></div>
    {{ form_end(form) }}
</section>
{% endblock %}
