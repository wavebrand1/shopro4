{% extends 'admin/layout.html.twig' %}
{% block title %}{{ page.id ? 'Edycja podstrony' : 'Nowa podstrona' }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="admin-heading"><div><p class="admin-eyebrow">Treść</p><h1>{{ page.id ? 'Edytuj podstronę' : 'Nowa podstrona' }}</h1></div><a class="button" href="{{ path('admin_page_index') }}">Wróć</a></div>
{{ form_start(form, {attr: {class: 'admin-form admin-form--page'}}) }}
    {{ form_row(form.title) }}
    {{ form_row(form.slug) }}
    {{ form_row(form.content) }}
    {{ form_row(form.published) }}
    <button class="button button--primary" type="submit">Zapisz</button>
{{ form_end(form) }}
{% endblock %}
