{% extends 'admin/layout.html.twig' %}
{% block title %}Konfiguracja systemu — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">KONFIGURACJA</p><h1>Konfiguracja systemu</h1><p>Ustawienia odpowiadają sekcjom konfiguracji Shopro Legacy.</p></div></div>
{% if not storage_available %}<div class="flash flash--error">Migracja konfiguracji nie została jeszcze wykonana. Formularz jest tymczasowo dostępny tylko do odczytu; uruchom ponownie wdrożenie.</div>{% endif %}
{{ form_start(form, {attr: {class: 'settings-form'}}) }}
{% set groups = {
    'Dane witryny i szablony': ['site_name','company','site_url','site_dir','site_email','theme','theme_variant','admin_theme','admin_theme_variant'],
    'Data, czas i język': ['date_short','date_long','time_format','timezone','locale','week_start','language'],
    'Widoczność elementów': ['show_login','show_search','show_breadcrumbs','show_language','eu_cookie'],
    'Tryb konserwacji': ['maintenance','maintenance_date','maintenance_time','maintenance_message'],
    'Obrazy responsywne': ['image_formats','image_widths','image_quality','image_lazy_loading'],
    'Paginacja i waluta (waluta zostanie przeniesiona do języków)': ['per_page','currency','currency_symbol','thousands_separator','decimal_separator'],
    'Rejestracja i bezpieczeństwo': ['registration_allowed','registration_verify','registration_auto_verify','notify_admin','user_limit','login_attempts','flood_seconds','logging','alert_email_template'],
    'Social media (dane dla modułu komponentów)': ['facebook','instagram','twitter','pinterest','linkedin','youtube','tiktok'],
    'SEO i analityka': ['analytics_measurement_id','analytics_consent_required','meta_keywords','meta_description'],
    'Wysyłka wiadomości przez SMTP': ['smtp_host','smtp_user','smtp_password','smtp_port','smtp_encryption','mail_from_address','mail_from_name','mail_reply_to']
} %}
{% for title, fields in groups %}
<section class="modern-card settings-card">
    <div class="modern-card__heading"><h2>{{ title }}</h2></div>
    <div class="settings-grid">
        {% for name in fields %}{% set control = attribute(form, name) %}<div class="settings-field settings-field--{{ control.vars.block_prefixes|last }}">{{ form_row(control) }}</div>{% endfor %}
    </div>
</section>
{% endfor %}
<div class="settings-actions"><button class="modern-button modern-button--primary" type="submit"{{ storage_available ? '' : ' disabled' }}>Zapisz konfigurację</button></div>
{{ form_end(form) }}
{% endblock %}
