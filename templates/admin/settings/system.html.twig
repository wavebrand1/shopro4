{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('settings.heading') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('language.configuration') }}</p><h1>{{ shopro_trans('settings.heading') }}</h1><p>{{ shopro_trans('settings.lead') }}</p></div></div>
{% if not storage_available %}<div class="flash flash--error">{{ shopro_trans('settings.storage_missing') }}</div>{% endif %}
{{ form_start(form, {attr: {class: 'settings-form'}}) }}
{% set groups = {
    'settings.group_website': ['site_name','company','site_url','site_dir','site_email','site_logo_file','remove_site_logo','favicon_file','remove_favicon','theme','theme_variant','admin_theme','admin_theme_variant'],
    'settings.group_datetime': ['date_short','date_long','time_format','timezone','locale','week_start','language'],
    'settings.group_visibility': ['show_login','show_search','show_breadcrumbs','show_language','eu_cookie'],
    'settings.group_maintenance': ['maintenance','maintenance_date','maintenance_time','maintenance_message'],
    'settings.group_images': ['image_formats','image_widths','image_quality','image_lazy_loading'],
    'settings.group_pagination': ['per_page','currency','currency_symbol','thousands_separator','decimal_separator'],
    'settings.group_security': ['registration_allowed','registration_verify','registration_auto_verify','notify_admin','user_limit','login_attempts','flood_seconds','logging','alert_email_template'],
    'settings.group_social': ['facebook','instagram','twitter','pinterest','linkedin','youtube','tiktok'],
    'settings.group_seo': ['analytics_measurement_id','analytics_consent_required','meta_keywords','meta_description'],
    'settings.group_smtp': ['smtp_host','smtp_user','smtp_password','smtp_port','smtp_encryption','mail_from_address','mail_from_name','mail_reply_to']
} %}
{% for title, fields in groups %}
<section class="modern-card settings-card">
    <div class="modern-card__heading"><h2>{{ shopro_trans(title) }}</h2></div>
    {% if loop.first and (shopro_setting('site_logo') or shopro_setting('favicon')) %}<div class="branding-preview">{% if shopro_setting('site_logo') %}<div><span>{{ shopro_trans('settings.current_logo') }}</span><img src="{{ shopro_setting('site_logo') }}" alt="{{ shopro_trans('settings.current_logo') }}"></div>{% endif %}{% if shopro_setting('favicon') %}<div><span>{{ shopro_trans('settings.current_favicon') }}</span><img class="branding-preview__favicon" src="{{ shopro_setting('favicon') }}" alt="{{ shopro_trans('settings.current_favicon') }}"></div>{% endif %}</div>{% endif %}
    <div class="settings-grid">
        {% for name in fields %}{% set control = attribute(form, name) %}<div class="settings-field settings-field--{{ control.vars.block_prefixes|last }}">{{ form_row(control) }}</div>{% endfor %}
    </div>
</section>
{% endfor %}
<div class="settings-actions"><button class="modern-button modern-button--primary" type="submit"{{ storage_available ? '' : ' disabled' }}>{{ shopro_trans('settings.save') }}</button></div>
{{ form_end(form) }}
{% endblock %}
