{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('logs.heading') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('admin.users_system') }}</p><h1>{{ shopro_trans('logs.heading') }}</h1><p>{{ shopro_trans('logs.lead') }}</p></div><form method="post" action="{{ path('admin_audit_log_clear') }}" onsubmit="return confirm('{{ shopro_trans('logs.clear_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('clear-audit-log') }}"><button class="modern-button modern-button--danger">{{ shopro_trans('logs.clear') }}</button></form></div>
<section class="modern-card"><form method="get" class="audit-filters"><label>{{ shopro_trans('logs.search') }}<input type="search" name="q" value="{{ filters.q }}" placeholder="{{ shopro_trans('logs.search_placeholder') }}"></label><label>{{ shopro_trans('logs.from') }}<input type="date" name="from" value="{{ filters.from }}"></label><label>{{ shopro_trans('logs.to') }}<input type="date" name="to" value="{{ filters.to }}"></label><label>{{ shopro_trans('logs.type') }}<select name="type"><option value="">{{ shopro_trans('logs.all_types') }}</option>{% for value in types %}<option value="{{ value }}"{{ filters.type == value ? ' selected' }}>{{ shopro_trans('logs.type_' ~ value) }}</option>{% endfor %}</select></label><label>{{ shopro_trans('logs.importance') }}<select name="important"><option value="">{{ shopro_trans('logs.all_importance') }}</option><option value="1"{{ filters.important == '1' ? ' selected' }}>{{ shopro_trans('logs.important_only') }}</option><option value="0"{{ filters.important == '0' ? ' selected' }}>{{ shopro_trans('logs.regular_only') }}</option></select></label><label>{{ shopro_trans('logs.per_page') }}<select name="limit">{% for value in [10,25,50,100] %}<option value="{{ value }}"{{ limit == value ? ' selected' }}>{{ value }}</option>{% endfor %}</select></label><button class="modern-button modern-button--primary">{{ shopro_trans('logs.filter') }}</button></form></section>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('logs.time') }}</th><th>{{ shopro_trans('logs.user') }}</th><th>IP</th><th>{{ shopro_trans('logs.type') }}</th><th>{{ shopro_trans('logs.event') }}</th><th>{{ shopro_trans('logs.message') }}</th><th><span class="sr-only">{{ shopro_trans('common.actions') }}</span></th></tr></thead><tbody>{% for log in logs %}<tr class="{{ log.important ? 'audit-row--important' }}"><td>{{ shopro_date(log.createdAt) }} {{ shopro_date(log.createdAt, 'time') }}</td><td>{{ log.username ?: '—' }}</td><td><code>{{ log.ipAddress ?: '—' }}</code></td><td><span class="status-pill">{{ shopro_trans('logs.type_' ~ log.type) }}</span></td><td><code>{{ log.action }}</code></td><td>{{ log.message }}</td><td><a class="table-action" href="{{ path('admin_audit_log_show',{id:log.id}) }}">{{ shopro_trans('logs.details') }}</a></td></tr>{% else %}<tr><td colspan="7" class="empty">{{ shopro_trans('logs.empty') }}</td></tr>{% endfor %}</tbody></table></div>
{% if pages > 1 %}<nav class="pagination" aria-label="{{ shopro_trans('logs.pagination') }}">{% for number in 1..pages %}<a class="{{ number == page ? 'is-active' }}" href="{{ path('admin_audit_log_index',filters|merge({page:number,limit:limit})) }}">{{ number }}</a>{% endfor %}</nav>{% endif %}</section>
{% endblock %}
