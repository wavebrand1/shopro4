<tr><td>{% if type == 'directory' %}<a href="{{ path('admin_file_manager_index',{path:item.path}) }}">📁 {{ item.name }}</a>{% else %}{% if item.image %}<a href="{{ item.url }}" target="_blank"><img src="{{ item.url }}" alt="" class="file-manager-thumb"></a>{% endif %}<a href="{{ item.url }}" target="_blank">{{ item.name }}</a>{% endif %}</td><td>{{ shopro_trans(type == 'directory' ? 'media.directory' : 'media.file') }}</td><td>{{ type == 'file' ? (item.size / 1024)|number_format(1, ',', ' ') ~ ' KB' : '—' }}</td><td>{{ item.modified|date('Y-m-d H:i') }}</td><td class="table-actions"><form method="post" class="inline-form"><input type="hidden" name="_token" value="{{ csrf_token('file-manager') }}"><input type="hidden" name="path" value="{{ listing.path }}"><input type="hidden" name="action" value="rename"><input type="hidden" name="item" value="{{ item.path }}"><input name="name" value="{{ item.name }}" required aria-label="{{ shopro_trans('media.new_name') }}"><button class="modern-button">{{ shopro_trans('media.rename') }}</button></form><form method="post" class="inline-form" onsubmit="return confirm('{{ shopro_trans('media.delete_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('file-manager') }}"><input type="hidden" name="path" value="{{ listing.path }}"><input type="hidden" name="action" value="delete"><input type="hidden" name="item" value="{{ item.path }}"><button class="table-action table-action--danger">{{ shopro_trans('common.delete') }}</button></form></td></tr>
