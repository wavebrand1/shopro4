{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('media.heading') }} — Shopro 4.0{% endblock %}
{% block javascripts %}{{ importmap(['app', 'file-manager']) }}{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('language.configuration') }}</p><h1>{{ shopro_trans(picker ? 'media.select_image' : 'media.heading') }}</h1><p>{{ shopro_trans(picker ? 'media.select_image_help' : 'media.lead') }}</p></div></div>
<nav class="file-breadcrumbs"><a href="{{ path('admin_file_manager_index',picker ? {picker:1} : {}) }}">uploads</a>{% set accumulated = '' %}{% for part in listing.path ? listing.path|split('/') : [] %}{% set accumulated = accumulated ~ (accumulated ? '/' : '') ~ part %}<span>/</span><a href="{{ path('admin_file_manager_index',{path:accumulated,picker:picker ? 1 : null}) }}">{{ part }}</a>{% endfor %}</nav>
{% set displayed_size = picker ? listing.image_size : listing.total_size %}
{% set displayed_count = picker ? listing.image_count : listing.file_count %}
{% set total_size = displayed_size >= 1048576 ? (displayed_size / 1048576)|number_format(1, ',', ' ') ~ ' MB' : (displayed_size >= 1024 ? (displayed_size / 1024)|number_format(1, ',', ' ') ~ ' KB' : displayed_size ~ ' B') %}
<section class="file-manager-summary" aria-label="{{ shopro_trans('media.summary') }}">
    <div><span>{{ shopro_trans('media.directories_count') }}</span><strong>{{ listing.directory_count }}</strong></div>
    <div><span>{{ shopro_trans(picker ? 'media.images_count' : 'media.files_count') }}</span><strong>{{ displayed_count }}</strong></div>
    <div><span>{{ shopro_trans('media.total_size') }}</span><strong>{{ total_size }}</strong></div>
</section>
<section class="modern-card"><div class="cms-card-body file-manager-actions">
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('file-manager') }}"><input type="hidden" name="path" value="{{ listing.path }}"><input type="hidden" name="picker" value="{{ picker ? 1 : 0 }}"><input type="hidden" name="action" value="mkdir"><label>{{ shopro_trans('media.new_directory') }}<input name="name" required></label><button class="modern-button">{{ shopro_trans('common.add') }}</button></form>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('file-manager') }}"><input type="hidden" name="path" value="{{ listing.path }}"><input type="hidden" name="picker" value="{{ picker ? 1 : 0 }}"><input type="hidden" name="action" value="touch"><label>{{ shopro_trans('media.new_file') }}<input name="name" required></label><button class="modern-button">{{ shopro_trans('common.add') }}</button></form>
<form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('file-manager') }}"><input type="hidden" name="path" value="{{ listing.path }}"><input type="hidden" name="picker" value="{{ picker ? 1 : 0 }}"><input type="hidden" name="action" value="upload"><label>{{ shopro_trans('media.upload_files') }}<input type="file" name="files[]"{% if picker %} accept="image/jpeg,image/png,image/webp,image/avif,image/gif"{% endif %} multiple required></label><button class="modern-button modern-button--primary">{{ shopro_trans('media.upload') }}</button></form>
</div></section>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('media.name') }}</th><th>{{ shopro_trans('media.type') }}</th><th>{{ shopro_trans('media.size') }}</th><th>{{ shopro_trans('media.modified') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>
{% if listing.parent is not null %}<tr><td><a href="{{ path('admin_file_manager_index',{path:listing.parent,picker:picker ? 1 : null}) }}">↰ ..</a></td><td>{{ shopro_trans('media.directory') }}</td><td>—</td><td>—</td><td></td></tr>{% endif %}
{% for item in listing.directories %}{% include 'admin/file_manager/_row.html.twig' with {item:item,type:'directory',picker:picker} %}{% endfor %}
{% set displayed_files = picker ? listing.files|filter(item => item.image) : listing.files %}
{% for item in displayed_files %}{% include 'admin/file_manager/_row.html.twig' with {item:item,type:'file',picker:picker} %}{% else %}{% if listing.directories is empty %}<tr><td colspan="5" class="empty">{{ shopro_trans(picker ? 'media.no_images' : 'media.empty') }}</td></tr>{% endif %}{% endfor %}
</tbody></table></div></section>
{% endblock %}
