{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('media.heading') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('language.configuration') }}</p><h1>{{ shopro_trans('media.heading') }}</h1><p>{{ shopro_trans('media.lead') }}</p></div></div>
<nav class="file-breadcrumbs"><a href="{{ path('admin_file_manager_index') }}">uploads</a>{% set accumulated = '' %}{% for part in listing.path ? listing.path|split('/') : [] %}{% set accumulated = accumulated ~ (accumulated ? '/' : '') ~ part %}<span>/</span><a href="{{ path('admin_file_manager_index',{path:accumulated}) }}">{{ part }}</a>{% endfor %}</nav>
<section class="modern-card"><div class="cms-card-body file-manager-actions">
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('file-manager') }}"><input type="hidden" name="path" value="{{ listing.path }}"><input type="hidden" name="action" value="mkdir"><label>{{ shopro_trans('media.new_directory') }}<input name="name" required></label><button class="modern-button">{{ shopro_trans('common.add') }}</button></form>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('file-manager') }}"><input type="hidden" name="path" value="{{ listing.path }}"><input type="hidden" name="action" value="touch"><label>{{ shopro_trans('media.new_file') }}<input name="name" required></label><button class="modern-button">{{ shopro_trans('common.add') }}</button></form>
<form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('file-manager') }}"><input type="hidden" name="path" value="{{ listing.path }}"><input type="hidden" name="action" value="upload"><label>{{ shopro_trans('media.upload_files') }}<input type="file" name="files[]" multiple required></label><button class="modern-button modern-button--primary">{{ shopro_trans('media.upload') }}</button></form>
</div></section>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('media.name') }}</th><th>{{ shopro_trans('media.type') }}</th><th>{{ shopro_trans('media.size') }}</th><th>{{ shopro_trans('media.modified') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>
{% if listing.parent is not null %}<tr><td><a href="{{ path('admin_file_manager_index',{path:listing.parent}) }}">↰ ..</a></td><td>{{ shopro_trans('media.directory') }}</td><td>—</td><td>—</td><td></td></tr>{% endif %}
{% for item in listing.directories %}{% include 'admin/file_manager/_row.html.twig' with {item:item,type:'directory'} %}{% endfor %}
{% for item in listing.files %}{% include 'admin/file_manager/_row.html.twig' with {item:item,type:'file'} %}{% else %}{% if listing.directories is empty %}<tr><td colspan="5" class="empty">{{ shopro_trans('media.empty') }}</td></tr>{% endif %}{% endfor %}
</tbody></table></div></section>
{% endblock %}
