{% extends 'admin/layout.html.twig' %}{% block title %}{{ language.id?'Edycja języka':'Nowy język' }} — Shopro 4.0{% endblock %}{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">KONFIGURACJA</p><h1>{{ language.id?'Edytuj język':'Dodaj język' }}</h1><p>Ustawienia języka, lokalizacji, liczb i waluty.</p></div><a class="modern-button" href="{{ path('admin_language_index') }}">← Wróć</a></div>{{ form_start(form,{attr:{class:'admin-form'}}) }}<section class="modern-card"><div class="cms-card-body"><div class="component-fields">{{ form_row(form.name) }}{{ form_row(form.code) }}{{ form_row(form.author) }}{{ form_row(form.subdomain) }}{{ form_row(form.locale) }}{{ form_row(form.currency) }}{{ form_row(form.currencySymbol) }}{{ form_row(form.decimalSeparator) }}{{ form_row(form.thousandsSeparator) }}</div>{{ form_row(form.direction) }}<div class="cms-option-grid">{{ form_row(form.active) }}{{ form_row(form.defaultLanguage) }}</div></div></section><div class="cms-sticky-actions"><button class="modern-button modern-button--primary">Zapisz język</button></div>{{ form_end(form) }}{% endblock %}
