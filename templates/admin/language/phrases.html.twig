{% extends 'admin/layout.html.twig' %}{% block title %}{{ shopro_trans('menu.translations') }} {{ language.name }} — Shopro 4.0{% endblock %}{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('language.dictionary') }} {{ language.code|upper }}</p><h1>{{ shopro_trans('language.translations_for') }} {{ language.name }}</h1><p>{{ shopro_trans('language.phrases_lead') }}</p></div><a class="modern-button" href="{{ path('admin_language_index') }}">← {{ shopro_trans('nav.languages') }}</a></div>
<section class="modern-card"><div class="cms-card-body"><form method="get" class="admin-user-search"><input name="q" value="{{ query }}" placeholder="{{ shopro_trans('language.search_phrases') }}"><button class="modern-button">{{ shopro_trans('common.search') }}</button></form><form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ csrf_token('language-phrases-'~language.id) }}"><div class="component-fields"><label>{{ shopro_trans('language.key') }}<input name="key" required placeholder="navigation.home"></label><label>{{ shopro_trans('language.translation') }}<textarea name="value" required rows="3"></textarea></label></div><button class="modern-button modern-button--primary">{{ shopro_trans('language.add_phrase') }}</button></form></div></section>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('language.key') }}</th><th>{{ shopro_trans('language.translation') }}</th><th>{{ shopro_trans('language.save_column') }}</th></tr></thead><tbody>{% for phrase in phrases %}<tr><td><code>{{ phrase.key }}</code></td><td><textarea form="phrase-{{ phrase.id }}" name="value" rows="2">{{ phrase.value }}</textarea></td><td><form id="phrase-{{ phrase.id }}" method="post"><input type="hidden" name="key" value="{{ phrase.key }}"><input type="hidden" name="_token" value="{{ csrf_token('language-phrases-'~language.id) }}"><button class="modern-button">{{ shopro_trans('common.save') }}</button></form></td></tr>{% else %}<tr><td colspan="3" class="empty">{{ shopro_trans('language.no_phrases') }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
