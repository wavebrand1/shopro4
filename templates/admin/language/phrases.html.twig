{% extends 'admin/layout.html.twig' %}{% block title %}Tłumaczenia {{ language.name }} — Shopro 4.0{% endblock %}{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">SŁOWNIK {{ language.code|upper }}</p><h1>Tłumaczenia: {{ language.name }}</h1><p>Wyszukuj i zapisuj pojedyncze frazy, tak jak w edytorze Legacy.</p></div><a class="modern-button" href="{{ path('admin_language_index') }}">← Języki</a></div>
<section class="modern-card"><div class="cms-card-body"><form method="get" class="admin-user-search"><input name="q" value="{{ query }}" placeholder="Szukaj klucza lub treści"><button class="modern-button">Szukaj</button></form><form method="post" class="admin-form"><input type="hidden" name="_token" value="{{ csrf_token('language-phrases-'~language.id) }}"><div class="component-fields"><label>Klucz<input name="key" required placeholder="navigation.home"></label><label>Tłumaczenie<textarea name="value" required rows="3"></textarea></label></div><button class="modern-button modern-button--primary">Dodaj frazę</button></form></div></section>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Klucz</th><th>Tłumaczenie</th><th>Zapis</th></tr></thead><tbody>{% for phrase in phrases %}<tr><td><code>{{ phrase.key }}</code></td><td><textarea form="phrase-{{ phrase.id }}" name="value" rows="2">{{ phrase.value }}</textarea></td><td><form id="phrase-{{ phrase.id }}" method="post"><input type="hidden" name="key" value="{{ phrase.key }}"><input type="hidden" name="_token" value="{{ csrf_token('language-phrases-'~language.id) }}"><button class="modern-button">Zapisz</button></form></td></tr>{% else %}<tr><td colspan="3" class="empty">Brak tłumaczeń spełniających kryteria.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
