{% extends 'admin/layout.html.twig' %}{% block title %}Języki — Shopro 4.0{% endblock %}{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">KONFIGURACJA</p><h1>Zarządzanie językami</h1><p>Języki witryny oraz ich słownik tłumaczeń.</p></div><a class="modern-button modern-button--primary" href="{{ path('admin_language_new') }}">+ Dodaj język</a></div>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Język</th><th>Kod</th><th>Kierunek</th><th>Autor</th><th>Subdomena</th><th>Status</th><th>Akcje</th></tr></thead><tbody>{% for language in languages %}<tr><td><strong>{{ language.name }}</strong></td><td>{{ language.code|upper }}</td><td>{{ language.direction|upper }}</td><td>{{ language.author?:'—' }}</td><td>{{ language.subdomain?:'—' }}</td><td><span class="status status--{{ language.active?'published':'draft' }}">{{ language.active?'Aktywny':'Nieaktywny' }}</span></td><td class="actions"><a href="{{ path('admin_language_phrases',{id:language.id}) }}">Tłumaczenia</a><a href="{{ path('admin_language_edit',{id:language.id}) }}">Edytuj</a><form method="post" action="{{ path('admin_language_delete',{id:language.id}) }}" onsubmit="return confirm('Usunąć język i wszystkie jego tłumaczenia?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-language-'~language.id) }}"><button>Usuń</button></form></td></tr>{% else %}<tr><td colspan="7">Brak języków.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
