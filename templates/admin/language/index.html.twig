{% extends 'admin/layout.html.twig' %}{% block title %}{{ shopro_trans('nav.languages') }} — Shopro 4.0{% endblock %}{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('language.configuration') }}</p><h1>{{ shopro_trans('language.management') }}</h1><p>{{ shopro_trans('language.management_lead') }}</p></div><a class="modern-button modern-button--primary" href="{{ path('admin_language_new') }}">+ {{ shopro_trans('language.add') }}</a></div>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('language.language') }}</th><th>{{ shopro_trans('language.code_short') }}</th><th>{{ shopro_trans('language.direction') }}</th><th>{{ shopro_trans('language.author_short') }}</th><th>{{ shopro_trans('language.subdomain_short') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>{% for language in languages %}<tr><td><strong>{{ language.name }}</strong></td><td>{{ language.code|upper }}</td><td>{{ language.direction|upper }}</td><td>{{ language.author?:'—' }}</td><td>{{ language.subdomain?:'—' }}</td><td><span class="status status--{{ language.active?'published':'draft' }}">{{ shopro_trans(language.active?'common.active':'common.inactive') }}</span></td><td class="actions"><a href="{{ path('admin_language_phrases',{id:language.id}) }}">{{ shopro_trans('menu.translations') }}</a><a href="{{ path('admin_language_edit',{id:language.id}) }}">{{ shopro_trans('common.edit') }}</a><form method="post" action="{{ path('admin_language_delete',{id:language.id}) }}" onsubmit="return confirm('{{ shopro_trans('language.delete_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('delete-language-'~language.id) }}"><button>{{ shopro_trans('common.delete') }}</button></form></td></tr>{% else %}<tr><td colspan="7">{{ shopro_trans('language.empty') }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
