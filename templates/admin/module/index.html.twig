{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('module.heading') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">SHOPRO 4.0</p><h1>{{ shopro_trans('module.heading') }}</h1><p>{{ shopro_trans('module.lead') }}</p></div></div>
<section class="modern-card modern-table-card">
    <div class="modern-card__heading"><div><h2>{{ shopro_trans('module.registered') }}</h2><p>{{ shopro_trans('module.registered_help') }}</p></div></div>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('module.name') }}</th><th>{{ shopro_trans('module.category') }}</th><th>{{ shopro_trans('module.dependencies') }}</th><th>{{ shopro_trans('module.version') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('module.type') }}</th></tr></thead><tbody>
    {% for module in modules %}
        <tr>
            <td><strong>{{ shopro_trans(module.definition.name) }}</strong><small class="table-help">{{ shopro_trans(module.definition.description) }}</small><code>{{ module.definition.code }}</code></td>
            <td>{{ shopro_trans('module.category_'~module.definition.category) }}</td>
            <td>{% for dependency in module.definition.dependencies %}<code>{{ dependency }} {{ module.definition.dependencyVersions[dependency] }}</code>{% else %}{{ shopro_trans('module.none') }}{% endfor %}</td>
            <td>{{ module.state ? module.state.version : module.definition.version }}</td>
            <td>
                {% if not module.state %}
                    <span class="status status--draft">{{ shopro_trans('module.awaiting_sync') }}</span>
                {% elseif module.state.enabled and not module.runtimeEnabled %}
                    <span class="status status--draft">{{ shopro_trans('module.runtime_blocked') }}</span>
                    <small class="table-help">{{ shopro_trans('module.runtime_blocked_help') }}</small>
                {% elseif not module.state.enabled %}
                    <span class="status status--draft">{{ shopro_trans('module.disabled') }}</span>
                {% else %}
                    <span class="status status--published">{{ shopro_trans('module.enabled') }}</span>
                {% endif %}
                {% if module.managementRoute and module.runtimeEnabled %}<a class="table-action" href="{{ path(module.managementRoute) }}">Zarządzaj</a>{% endif %}
            </td>
            <td>
                {{ shopro_trans(module.definition.required ? 'module.required' : 'module.optional') }}
                {% if module.state and (not module.state.enabled or not module.definition.required) %}
                    <form method="post" action="{{ path(module.state.enabled ? 'admin_module_disable' : 'admin_module_enable',{code:module.definition.code}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('module-state-'~module.definition.code) }}">
                        <button class="table-action"{{ module.transition and not module.transition.allowed ? ' disabled' }}>{{ shopro_trans(module.state.enabled ? 'module.disable' : 'module.enable') }}</button>
                    </form>
                    {% if module.transition and not module.transition.allowed %}
                        <small class="table-help">{{ shopro_trans(module.transition.reason) }}</small>
                    {% endif %}
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="6" class="empty">{{ shopro_trans('module.empty') }}</td></tr>
    {% endfor %}
    </tbody></table></div>
</section>
{% if orphaned %}<section class="modern-card modern-table-card"><div class="modern-card__heading"><div><h2>{{ shopro_trans('module.orphaned') }}</h2><p>{{ shopro_trans('module.orphaned_help') }}</p></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('module.code') }}</th><th>{{ shopro_trans('module.version') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('module.updated') }}</th></tr></thead><tbody>{% for module in orphaned %}<tr><td><code>{{ module.code }}</code></td><td>{{ module.version }}</td><td><span class="status status--draft">{{ shopro_trans('module.code_missing') }}</span></td><td>{{ shopro_date(module.updatedAt) }} {{ shopro_date(module.updatedAt,'time') }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
<section class="modern-card"><div class="modern-card__heading"><div><h2>{{ shopro_trans('module.lifecycle_heading') }}</h2><p>{{ shopro_trans('module.lifecycle_help') }}</p></div></div></section>
{% endblock %}
