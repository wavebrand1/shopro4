{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('site_users.heading') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('site_users.access_management') }}</p><h1>{{ shopro_trans('site_users.heading') }}</h1><p>{{ shopro_trans('site_users.lead') }}</p></div><a class="modern-button modern-button--primary" href="{{ path('admin_site_user_new') }}">+ {{ shopro_trans('site_users.new') }}</a></div>
<section class="modern-card modern-table-card"><div class="modern-card__heading"><form method="get" class="admin-user-search"><input name="q" value="{{ query }}" placeholder="{{ shopro_trans('site_users.search') }}"><button class="modern-button">{{ shopro_trans('common.search') }}</button></form></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('site_users.user') }}</th><th>{{ shopro_trans('site_users.memberships') }}</th><th>{{ shopro_trans('common.created_at') }}</th><th>{{ shopro_trans('site_users.last_login') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>
{% for user in users %}<tr><td><div class="page-cell"><span class="page-cell__icon">{{ user.username|first|upper }}</span><div><strong>{{ user.username }}</strong><small>{{ user.email }}</small></div></div></td><td>{% for membership in user.memberships %}<span class="status status--{{ membership.active ? 'published' : 'draft' }}">{{ membership.title }}</span>{% else %}—{% endfor %}</td><td>{{ shopro_date(user.createdAt) }}</td><td>{{ user.lastLoginAt ? shopro_date(user.lastLoginAt) : '—' }}</td><td><span class="status status--{{ user.active ? 'published' : 'draft' }}"><i></i>{{ shopro_trans(user.active ? 'common.active' : 'common.inactive') }}</span></td><td class="actions"><a href="{{ path('admin_site_user_edit',{id:user.id}) }}">{{ shopro_trans('common.edit') }}</a><form method="post" action="{{ path('admin_site_user_delete',{id:user.id}) }}" onsubmit="return confirm('{{ shopro_trans('site_users.delete_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('delete-site-user-'~user.id) }}"><button>{{ shopro_trans('common.delete') }}</button></form></td></tr>{% else %}<tr><td colspan="6" class="empty">{{ shopro_trans('site_users.empty') }}</td></tr>{% endfor %}
</tbody></table></div>{% include 'admin/_pagination.html.twig' with {query_params:{q:query}} %}</section>
{% endblock %}
