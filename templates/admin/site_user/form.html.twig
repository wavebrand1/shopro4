{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans(user.id ? 'site_users.edit' : 'site_users.new') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('site_users.access_management') }}</p><h1>{{ shopro_trans(user.id ? 'site_users.edit' : 'site_users.new') }}</h1><p>{{ shopro_trans('site_users.form_help') }}</p></div><a class="modern-button" href="{{ path('admin_site_user_index') }}">← {{ shopro_trans('common.back') }}</a></div>
{{ form_start(form,{attr:{class:'admin-form'}}) }}<section class="modern-card"><div class="modern-card__heading"><div><h2>{{ shopro_trans('site_users.account_data') }}</h2><p>{{ shopro_trans('site_users.password_help') }}</p></div></div><div class="cms-card-body"><div class="component-fields">{{ form_row(form.username) }}{{ form_row(form.email) }}{{ form_row(form.plainPassword) }}</div><div class="cms-option-grid">{{ form_row(form.active) }}{{ form_row(form.newsletter) }}</div>{{ form_row(form.memberships) }}</div></section><div class="cms-sticky-actions"><a class="modern-button" href="{{ path('admin_site_user_index') }}">{{ shopro_trans('common.cancel') }}</a><button class="modern-button modern-button--primary">{{ shopro_trans('site_users.save') }}</button></div>{{ form_end(form) }}
{% endblock %}
