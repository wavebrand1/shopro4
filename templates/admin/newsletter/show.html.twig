{% extends 'admin/layout.html.twig' %}
{% block title %}Szczegóły kampanii — Shopro 4.0{% endblock %}
{% block body %}
{% set labels={draft:'Szkic',queued:'W kolejce',sent:'Wysłana',failed:'Błąd wysyłki',no_recipients:'Brak odbiorców'} %}
<div class="modern-page-heading"><div><p class="modern-kicker">NEWSLETTER</p><h1>{{ campaign.subject }}</h1><p>Szczegóły kampanii i historia wszystkich dostarczeń.</p></div><div class="actions"><a class="modern-button" href="{{ path('admin_newsletter_index') }}">← Wróć</a><a class="modern-button modern-button--primary" href="{{ path('admin_newsletter_edit',{id:campaign.id}) }}">Edytuj</a></div></div>
<section class="modern-card"><div class="modern-card__heading"><h2>Informacje</h2></div><div class="cms-card-body"><div class="component-fields"><div><strong>Status</strong><p>{{ labels[campaign.status]|default(campaign.status) }}</p></div><div><strong>Utworzono</strong><p>{{ campaign.createdAt|date('d.m.Y H:i') }}</p></div><div><strong>Zakolejkowano</strong><p>{{ campaign.queuedAt ? campaign.queuedAt|date('d.m.Y H:i') : '—' }}</p></div><div><strong>Odbiorcy</strong><p>{{ deliveries|length }}</p></div></div><div class="actions"><form method="post" action="{{ path('admin_newsletter_resend',{id:campaign.id}) }}" onsubmit="return confirm('Utworzyć nowe wykonanie tej kampanii i wysłać ją ponownie?')"><input type="hidden" name="_token" value="{{ csrf_token('resend-newsletter-'~campaign.id) }}"><button class="modern-button modern-button--primary">Wyślij ponownie</button></form>{% if campaign.status=='failed' %}<form method="post" action="{{ path('admin_newsletter_retry',{id:campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('retry-newsletter-'~campaign.id) }}"><button class="modern-button">Ponów tylko błędne</button></form>{% endif %}</div></div></section>
<section class="modern-card"><div class="modern-card__heading"><h2>Treść wiadomości</h2></div><div class="cms-card-body"><div class="email-content-preview">{{ campaign.content|striptags }}</div></div></section>
<section class="modern-card modern-table-card"><div class="modern-card__heading"><h2>Historia dostarczeń</h2><p>Wysłane: {{ counts.sent|default(0) }}, oczekujące: {{ counts.queued|default(0) }}, błędne: {{ counts.failed|default(0) }}</p></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Odbiorca</th><th>Status</th><th>Wysłano</th><th>Błąd</th></tr></thead><tbody>{% for delivery in deliveries %}<tr><td>{{ delivery.recipient }}</td><td><span class="status status--{{ delivery.status=='sent'?'published':'draft' }}">{{ delivery.status }}</span></td><td>{{ delivery.sentAt ? delivery.sentAt|date('d.m.Y H:i') : '—' }}</td><td>{{ delivery.error ?: '—' }}</td></tr>{% else %}<tr><td colspan="4" class="empty">Kampania nie ma jeszcze dostarczeń.</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
