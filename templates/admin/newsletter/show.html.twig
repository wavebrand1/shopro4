{% extends 'admin/layout.html.twig' %}{% block title %}{{ shopro_trans('newsletter.campaign_details') }} — Shopro 4.0{% endblock %}{% block body %}
{% set labels={draft:'newsletter.status_draft',queued:'newsletter.status_queued',sent:'newsletter.status_sent',failed:'newsletter.status_failed',no_recipients:'newsletter.status_no_recipients'} %}
<div class="modern-page-heading"><div><p class="modern-kicker">NEWSLETTER</p><h1>{{ campaign.subject }}</h1><p>{{ shopro_trans('newsletter.details_lead') }}</p></div><div class="actions"><a class="modern-button" href="{{ path('admin_newsletter_index') }}">← {{ shopro_trans('common.back') }}</a><a class="modern-button" href="{{ path('admin_newsletter_preview',{id:campaign.id}) }}" target="_blank" rel="noopener">{{ shopro_trans('newsletter.preview_email') }}</a><a class="modern-button modern-button--primary" href="{{ path('admin_newsletter_edit',{id:campaign.id}) }}">{{ shopro_trans('common.edit') }}</a></div></div>
<section class="modern-card"><div class="modern-card__heading"><h2>{{ shopro_trans('newsletter.information') }}</h2></div><div class="cms-card-body"><div class="component-fields"><div><strong>{{ shopro_trans('common.status') }}</strong><p>{{ shopro_trans(labels[campaign.status]|default('newsletter.status_draft')) }}</p></div><div><strong>{{ shopro_trans('newsletter.created') }}</strong><p>{{ shopro_date(campaign.createdAt) }} {{ shopro_date(campaign.createdAt,'time') }}</p></div><div><strong>{{ shopro_trans('newsletter.queued_at') }}</strong><p>{{ campaign.queuedAt ? shopro_date(campaign.queuedAt) ~ ' ' ~ shopro_date(campaign.queuedAt,'time') : '—' }}</p></div><div><strong>{{ shopro_trans('newsletter.recipients') }}</strong><p>{{ delivery_total }}</p></div></div><div class="actions"><form method="post" action="{{ path('admin_newsletter_resend',{id:campaign.id}) }}" onsubmit="return confirm('{{ shopro_trans('newsletter.resend_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('resend-newsletter-'~campaign.id) }}"><button class="modern-button modern-button--primary">{{ shopro_trans('newsletter.resend') }}</button></form>{% if campaign.status=='failed' %}<form method="post" action="{{ path('admin_newsletter_retry',{id:campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('retry-newsletter-'~campaign.id) }}"><button class="modern-button">{{ shopro_trans('newsletter.retry_failed_only') }}</button></form>{% endif %}</div></div></section>
<section class="modern-card"><div class="modern-card__heading"><h2>{{ shopro_trans('newsletter.message_content') }}</h2></div><div class="cms-card-body"><div class="email-content-preview">{{ campaign.content|striptags }}</div></div></section>
<section class="modern-card"><div class="modern-card__heading"><div><h2>{{ shopro_trans('newsletter.test_heading') }}</h2><p>{{ shopro_trans('newsletter.test_help') }}</p></div></div><div class="cms-card-body"><form method="post" action="{{ path('admin_newsletter_test',{id:campaign.id}) }}" class="admin-user-search"><input type="email" name="recipient" value="{{ app.user.email }}" required><input type="hidden" name="_token" value="{{ csrf_token('test-newsletter-'~campaign.id) }}"><button class="modern-button modern-button--primary">{{ shopro_trans('newsletter.send_test') }}</button></form></div></section>
<section class="modern-card modern-table-card"><div class="modern-card__heading"><h2>{{ shopro_trans('newsletter.delivery_history') }}</h2><p>{{ shopro_trans('newsletter.sent_count') }} {{ counts.sent|default(0) }}, {{ shopro_trans('newsletter.queued_count_label') }} {{ counts.queued|default(0) }}, {{ shopro_trans('newsletter.failed_count') }} {{ counts.failed|default(0) }}</p></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('newsletter.recipient') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('newsletter.sent_at') }}</th><th>{{ shopro_trans('newsletter.error') }}</th></tr></thead><tbody>{% for delivery in deliveries %}<tr><td>{{ delivery.recipient }}</td><td><span class="status status--{{ delivery.status=='sent'?'published':'draft' }}">{{ shopro_trans(labels[delivery.status]|default('newsletter.status_queued')) }}</span></td><td>{{ delivery.sentAt ? shopro_date(delivery.sentAt) ~ ' ' ~ shopro_date(delivery.sentAt,'time') : '—' }}</td><td>{{ delivery.error ?: '—' }}</td></tr>{% else %}<tr><td colspan="4" class="empty">{{ shopro_trans('newsletter.no_deliveries') }}</td></tr>{% endfor %}</tbody></table></div>{% include 'admin/_pagination.html.twig' with {query_params:{id:campaign.id}} %}</section>
{% endblock %}
