{% extends 'admin/layout.html.twig' %}{% block title %}Newsletter — Shopro 4.0{% endblock %}{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">WIADOMOŚCI E-MAIL</p><h1>Newsletter</h1><p>Kampanie, kolejka wysyłkowa i historia ostatnich dostarczeń.</p></div><a class="modern-button modern-button--primary" href="{{ path('admin_newsletter_new') }}">+ Nowa kampania</a></div>
{% set labels = {draft:'Szkic',queued:'W kolejce',sent:'Wysłana',failed:'Błąd wysyłki',no_recipients:'Brak odbiorców'} %}
<section class="modern-card modern-table-card"><div class="modern-card__heading"><h2>Kampanie</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Temat</th><th>Status</th><th>Dostarczenia</th><th>Utworzono</th><th>Akcje</th></tr></thead><tbody>{% for campaign in campaigns %}{% set count = delivery_counts[campaign.id]|default(0) %}<tr><td><strong>{{ campaign.subject }}</strong></td><td><span class="status status--{{ campaign.status == 'sent' ? 'published' : 'draft' }}">{{ count == 0 and campaign.status != 'draft' ? 'Brak odbiorców' : labels[campaign.status]|default(campaign.status) }}</span></td><td>{{ count }}</td><td>{{ campaign.createdAt|date('d.m.Y H:i') }}</td><td>{% if count == 0 %}<form method="post" action="{{ path('admin_newsletter_queue',{id:campaign.id}) }}" onsubmit="return confirm('Zakolejkować wysyłkę do wszystkich zapisanych odbiorców?')"><input type="hidden" name="_token" value="{{ csrf_token('queue-newsletter-' ~ campaign.id) }}"><button class="modern-button modern-button--primary">{{ campaign.status == 'draft' ? 'Wyślij' : 'Spróbuj ponownie' }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="empty">Brak kampanii.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="modern-card modern-table-card"><div class="modern-card__heading"><h2>Historia dostarczeń</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Odbiorca</th><th>Kampania</th><th>Status</th><th>Wysłano / błąd</th></tr></thead><tbody>{% for delivery in deliveries %}<tr><td>{{ delivery.recipient }}</td><td>{{ delivery.campaign.subject }}</td><td><span class="status status--{{ delivery.status == 'sent' ? 'published' : 'draft' }}">{{ delivery.status }}</span></td><td>{{ delivery.sentAt ? delivery.sentAt|date('d.m.Y H:i') : (delivery.error ?: 'Oczekuje na worker kolejki') }}</td></tr>{% else %}<tr><td colspan="4" class="empty">Brak historii wysyłki. Zaznacz Newsletter na co najmniej jednym aktywnym koncie użytkownika.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
