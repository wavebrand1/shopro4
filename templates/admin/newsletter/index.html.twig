{% extends 'admin/layout.html.twig' %}{% block title %}Newsletter — Shopro 4.0{% endblock %}{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('newsletter.email_messages') }}</p><h1>{{ shopro_trans('newsletter.heading') }}</h1><p>{{ shopro_trans('newsletter.lead') }}</p></div><a class="modern-button modern-button--primary" href="{{ path('admin_newsletter_new') }}">+ {{ shopro_trans('newsletter.new_campaign') }}</a></div>
{% set labels={draft:'newsletter.status_draft',queued:'newsletter.status_queued',sent:'newsletter.status_sent',failed:'newsletter.status_failed',no_recipients:'newsletter.status_no_recipients'} %}
<section class="modern-card queue-health queue-health--{{ queue_health.state }}">
    <div class="modern-card__heading">
        <div><h2>{{ shopro_trans('newsletter.queue_health') }}</h2><p>{{ shopro_trans('newsletter.queue_health_help') }}</p></div>
        <span class="status status--{{ queue_health.state == 'healthy' ? 'published' : 'draft' }}"><i></i>{{ shopro_trans('newsletter.queue_state_' ~ queue_health.state) }}</span>
    </div>
    <div class="queue-health__stats">
        <div><small>{{ shopro_trans('newsletter.worker_status') }}</small><strong>{{ shopro_trans('newsletter.worker_state_' ~ queue_health.workerState) }}</strong></div>
        <div><small>{{ shopro_trans('newsletter.queue_pending') }}</small><strong>{{ queue_health.pending }}</strong></div>
        <div><small>{{ shopro_trans('newsletter.queue_failed') }}</small><strong>{{ queue_health.failed }}</strong></div>
        <div><small>{{ shopro_trans('newsletter.queue_last_run') }}</small><strong>{{ queue_health.lastRunAt ? shopro_date(queue_health.lastRunAt) ~ ' ' ~ shopro_date(queue_health.lastRunAt, 'time') : shopro_trans('newsletter.queue_never') }}</strong></div>
    </div>
    {% if queue_health.state != 'healthy' %}<p class="queue-health__notice">{{ shopro_trans('newsletter.queue_attention') }}</p>{% endif %}
</section>
<section class="modern-card modern-table-card"><div class="modern-card__heading"><h2>{{ shopro_trans('newsletter.campaigns') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('newsletter.subject') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('newsletter.deliveries') }}</th><th>{{ shopro_trans('newsletter.created') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>
{% for campaign in campaigns %}{% set count=delivery_counts[campaign.id]|default(0) %}<tr><td><strong>{{ campaign.subject }}</strong></td><td><span class="status status--{{ campaign.status=='sent'?'published':'draft' }}">{{ shopro_trans(count==0 and campaign.status!='draft'?'newsletter.status_no_recipients':labels[campaign.status]|default('newsletter.status_draft')) }}</span></td><td>{{ count }}</td><td>{{ shopro_date(campaign.createdAt) }} {{ shopro_date(campaign.createdAt,'time') }}</td><td class="actions">
<a class="modern-button" href="{{ path('admin_newsletter_show',{id:campaign.id}) }}">{{ shopro_trans('newsletter.details') }}</a><a class="modern-button" href="{{ path('admin_newsletter_edit',{id:campaign.id}) }}">{{ shopro_trans('common.edit') }}</a>
{% if count==0 %}<form method="post" action="{{ path('admin_newsletter_queue',{id:campaign.id}) }}" onsubmit="return confirm('{{ shopro_trans('newsletter.queue_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('queue-newsletter-'~campaign.id) }}"><button class="modern-button modern-button--primary">{{ shopro_trans(campaign.status=='draft'?'newsletter.send':'newsletter.try_again') }}</button></form>{% endif %}
{% if campaign.status=='failed' %}<form method="post" action="{{ path('admin_newsletter_retry',{id:campaign.id}) }}" onsubmit="return confirm('{{ shopro_trans('newsletter.retry_failed_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('retry-newsletter-'~campaign.id) }}"><button class="modern-button modern-button--primary">{{ shopro_trans('newsletter.retry_failed') }}</button></form>{% endif %}
{% if count>0 %}<form method="post" action="{{ path('admin_newsletter_resend',{id:campaign.id}) }}" onsubmit="return confirm('{{ shopro_trans('newsletter.resend_confirm')|e('js') }}')"><input type="hidden" name="_token" value="{{ csrf_token('resend-newsletter-'~campaign.id) }}"><button class="modern-button modern-button--primary">{{ shopro_trans('newsletter.resend') }}</button></form>{% endif %}</td></tr>
{% else %}<tr><td colspan="5" class="empty">{{ shopro_trans('newsletter.no_campaigns') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="modern-card modern-table-card"><div class="modern-card__heading"><h2>{{ shopro_trans('newsletter.delivery_history') }}</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('newsletter.recipient') }}</th><th>{{ shopro_trans('newsletter.campaign') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('newsletter.sent_or_error') }}</th></tr></thead><tbody>{% for delivery in deliveries %}<tr><td>{{ delivery.recipient }}</td><td><a href="{{ path('admin_newsletter_show',{id:delivery.campaign.id}) }}">{{ delivery.campaign.subject }}</a></td><td><span class="status status--{{ delivery.status=='sent'?'published':'draft' }}">{{ shopro_trans(labels[delivery.status]|default('newsletter.status_queued')) }}</span></td><td>{{ delivery.sentAt ? shopro_date(delivery.sentAt) ~ ' ' ~ shopro_date(delivery.sentAt,'time') : (delivery.error ?: shopro_trans('newsletter.waiting_worker')) }}</td></tr>{% else %}<tr><td colspan="4" class="empty">{{ shopro_trans('newsletter.no_history') }}</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
