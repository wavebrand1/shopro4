{% extends 'admin/layout.html.twig' %}
{% block title %}Nowa kampania — Shopro 4.0{% endblock %}
{% block javascripts %}{{ importmap(['app','rich-editor']) }}{% endblock %}
{% block body %}<div class="modern-page-heading"><div><p class="modern-kicker">NEWSLETTER</p><h1>Nowa kampania</h1><p>Wybierz odbiorców i przygotuj wiadomość w responsywnej ramie 600 px.</p></div><a class="modern-button" href="{{ path('admin_newsletter_index') }}">← Wróć</a></div>{{ form_start(form,{attr:{class:'admin-form'}}) }}
<section class="modern-card"><div class="modern-card__heading"><h2>Odbiorcy kampanii</h2></div><div class="cms-card-body">{{ form_row(form.includeSubscribers) }}{{ form_row(form.selectedUserIds) }}{{ form_row(form.customEmails) }}</div></section>
<section class="modern-card"><div class="modern-card__heading"><h2>Wiadomość</h2></div><div class="cms-card-body">{{ form_row(form.subject) }}<div class="email-rich-editor">{{ form_row(form.content) }}</div></div></section><div class="cms-sticky-actions"><button class="modern-button modern-button--primary">Zapisz szkic</button></div>{{ form_end(form) }}{% endblock %}
