{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans(campaign.id ? 'newsletter.edit_campaign' : 'newsletter.new_campaign') }} — Shopro 4.0{% endblock %}
{% block javascripts %}{{ importmap(['app','rich-editor','newsletter-template']) }}{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">NEWSLETTER</p><h1>{{ shopro_trans(campaign.id ? 'newsletter.edit_campaign' : 'newsletter.new_campaign') }}</h1><p>{{ shopro_trans('newsletter.form_lead') }}</p></div><a class="modern-button" href="{{ campaign.id ? path('admin_newsletter_show',{id:campaign.id}) : path('admin_newsletter_index') }}">← {{ shopro_trans('common.back') }}</a></div>
{{ form_start(form,{attr:{class:'admin-form'}}) }}
<section class="modern-card"><div class="modern-card__heading"><h2>{{ shopro_trans('newsletter.campaign_recipients') }}</h2></div><div class="cms-card-body">{{ form_row(form.includeSubscribers) }}{{ form_row(form.selectedSiteUserIds) }}{{ form_row(form.customEmails) }}{{ form_row(form.recipientFile) }}</div></section>
<section class="modern-card"><div class="modern-card__heading"><h2>{{ shopro_trans('newsletter.message') }}</h2></div><div class="cms-card-body"><div class="component-fields"><label class="ui-field"><span>{{ shopro_trans('newsletter.source_template') }}</span><select data-newsletter-template><option value="">{{ shopro_trans('newsletter.select_template') }}</option>{% for email_template in email_templates %}<option value="{{ email_template.id }}" data-subject="{{ email_template.subject|e('html_attr') }}" data-content="{{ email_template.content|e('html_attr') }}">{{ email_template.name }} — {{ email_template.code }}</option>{% endfor %}</select><small>{{ shopro_trans('newsletter.source_template_help') }}</small></label><div class="ui-field"><span>&nbsp;</span><button class="modern-button" type="button" data-newsletter-template-load disabled data-confirm="{{ shopro_trans('newsletter.template_replace_confirm')|e('html_attr') }}">{{ shopro_trans('newsletter.load_template') }}</button></div></div>{{ form_row(form.subject) }}<div class="email-rich-editor">{{ form_row(form.content) }}</div></div></section>
<div class="cms-sticky-actions"><button class="modern-button modern-button--primary">{{ shopro_trans(campaign.id ? 'newsletter.save_changes' : 'newsletter.save_draft') }}</button></div>
{{ form_end(form) }}
{% endblock %}
