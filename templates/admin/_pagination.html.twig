{% if last_page > 1 %}<nav class="admin-pagination" aria-label="Paginacja">{% set params = query_params|default({}) %}{% if current_page > 1 %}<a href="{{ path(app.request.attributes.get('_route'), params|merge({page:current_page - 1})) }}">← Poprzednia</a>{% endif %}<span>Strona {{ current_page }} z {{ last_page }}</span>{% if current_page < last_page %}<a href="{{ path(app.request.attributes.get('_route'), params|merge({page:current_page + 1})) }}">Następna →</a>{% endif %}</nav>{% endif %}
