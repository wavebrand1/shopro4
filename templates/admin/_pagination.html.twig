{% if last_page > 1 %}<nav class="admin-pagination" aria-label="{{ shopro_trans('pagination.label') }}">{% set params = query_params|default({}) %}{% if current_page > 1 %}<a href="{{ path(app.request.attributes.get('_route'), params|merge({page:current_page - 1})) }}">← {{ shopro_trans('pagination.previous') }}</a>{% endif %}<span>{{ shopro_trans('pagination.page') }} {{ current_page }} {{ shopro_trans('pagination.of') }} {{ last_page }}</span>{% if current_page < last_page %}<a href="{{ path(app.request.attributes.get('_route'), params|merge({page:current_page + 1})) }}">{{ shopro_trans('pagination.next') }} →</a>{% endif %}</nav>{% endif %}
