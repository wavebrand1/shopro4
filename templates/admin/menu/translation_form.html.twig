{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('menu.translations') }} {{ language.name }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ language.code|upper }} · {{ language.name }}</p><h1>{{ item.name }}</h1><p>{{ shopro_trans('menu.translate_help') }}</p></div><a class="modern-button" href="{{ path('admin_menu_translation_index',{id:item.id}) }}">← {{ shopro_trans('menu.versions') }}</a></div>
<section class="modern-card modern-form-card">{{ form_start(form,{attr:{class:'admin-form admin-form--page'}}) }}<div class="cms-card-body"><div class="modern-form-grid">{{ form_row(form.name) }}{{ form_row(form.caption) }}{{ form_row(form.link) }}</div></div><div class="modern-form-actions"><a class="modern-button" href="{{ path('admin_menu_translation_index',{id:item.id}) }}">{{ shopro_trans('common.cancel') }}</a><button class="modern-button modern-button--primary">{{ shopro_trans('menu.save_translation') }}</button></div>{{ form_end(form) }}</section>
{% endblock %}
