{% extends 'admin/layout.html.twig' %}
{% block title %}Tłumaczenia menu — Shopro 4.0{% endblock %}
{% block body %}<div class="modern-page-heading"><div><p class="modern-kicker">WIELOJĘZYCZNOŚĆ</p><h1>{{ item.name }}</h1><p>Struktura i kolejność są wspólne, a nazwa i podpis zależą od języka.</p></div><a class="modern-button" href="{{ path('admin_menu_index') }}">← Menu</a></div><section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Język</th><th>Nazwa</th><th>Status</th><th>Akcja</th></tr></thead><tbody>{% for language in languages %}{% set translation=translations[language.id]|default(null) %}<tr><td><strong>{{ language.name }}</strong></td><td>{{ translation?translation.name:'—' }}</td><td>{{ translation?'Przetłumaczone':'Wersja bazowa' }}</td><td><a href="{{ path('admin_menu_translation_edit',{id:item.id,languageId:language.id}) }}">{{ translation?'Edytuj':'Utwórz tłumaczenie' }}</a></td></tr>{% else %}<tr><td colspan="4" class="empty">Brak aktywnych języków dodatkowych.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
