{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('menu.translations') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('menu.multilingual') }}</p><h1>{{ item.name }}</h1><p>{{ shopro_trans('menu.translations_help') }}</p></div><a class="modern-button" href="{{ path('admin_menu_index') }}">← {{ shopro_trans('menu.heading') }}</a></div>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('menu.language') }}</th><th>{{ shopro_trans('menu.name') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>
{% for language in languages %}{% set translation=translations[language.id]|default(null) %}<tr><td><strong>{{ language.name }}</strong></td><td>{{ translation ? translation.name : '—' }}</td><td>{{ shopro_trans(translation ? 'menu.translated' : 'menu.base_version') }}</td><td><a href="{{ path('admin_menu_translation_edit',{id:item.id,languageId:language.id}) }}">{{ shopro_trans(translation ? 'common.edit' : 'menu.create_translation') }}</a></td></tr>{% else %}<tr><td colspan="4" class="empty">{{ shopro_trans('menu.no_languages') }}</td></tr>{% endfor %}
</tbody></table></div></section>
{% endblock %}
