{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans(item.id ? 'menu.edit' : 'menu.new_full') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('admin.content_management') }}</p><h1>{{ shopro_trans(item.id ? 'menu.edit' : 'menu.new_full') }}</h1><p>{{ shopro_trans('menu.form_lead') }}</p></div><div class="modern-heading-actions">{% if item.id %}<a class="modern-button" href="{{ path('admin_menu_translation_index',{id:item.id}) }}">{{ shopro_trans('menu.translations') }}</a>{% endif %}<a class="modern-button" href="{{ path('admin_menu_index') }}">← {{ shopro_trans('common.back') }}</a></div></div>
<section class="modern-card modern-form-card"><div class="modern-card__heading"><div><h2>{{ shopro_trans('menu.item_data') }}</h2><p>{{ shopro_trans('menu.legacy_help') }}</p></div></div>
{{ form_start(form, {attr: {class: 'admin-form admin-form--page'}}) }}
<div class="modern-form-grid" data-menu-content-form>{{ form_row(form.name) }}{{ form_row(form.caption) }}{{ form_row(form.parent) }}{{ form_row(form.contentType) }}{{ form_row(form.page) }}{{ form_row(form.moduleReference) }}{{ form_row(form.link) }}{{ form_row(form.target) }}{{ form_row(form.place) }}</div>
<div class="modern-publish-row">{{ form_row(form.homePage) }}{{ form_row(form.active) }}<p>{{ shopro_trans('menu.type_help') }}</p></div>
<div class="modern-form-actions"><a class="modern-button" href="{{ path('admin_menu_index') }}">{{ shopro_trans('common.cancel') }}</a><button class="modern-button modern-button--primary" type="submit">{{ shopro_trans('menu.save') }}</button></div>{{ form_end(form) }}
</section>
{% endblock %}
