{% extends 'admin/layout.html.twig' %}
{% block title %}{{ shopro_trans('membership.heading') }} — Shopro 4.0{% endblock %}
{% block body %}
<div class="modern-page-heading"><div><p class="modern-kicker">{{ shopro_trans('admin.users_system') }}</p><h1>{{ shopro_trans('membership.heading') }}</h1><p>{{ shopro_trans('membership.lead') }}</p></div><a class="modern-button modern-button--primary" href="{{ path('admin_membership_new') }}">+ {{ shopro_trans('membership.new') }}</a></div>
<section class="modern-card modern-table-card"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>{{ shopro_trans('membership.name') }}</th><th>{{ shopro_trans('membership.description') }}</th><th>{{ shopro_trans('common.status') }}</th><th>{{ shopro_trans('common.actions') }}</th></tr></thead><tbody>{% for membership in memberships %}<tr><td><strong>{{ membership.title }}</strong></td><td>{{ membership.description ?: '—' }}</td><td><span class="status status--{{ membership.active ? 'published' : 'draft' }}">{{ shopro_trans(membership.active ? 'membership.active' : 'membership.inactive') }}</span></td><td><a href="{{ path('admin_membership_edit',{id:membership.id}) }}">{{ shopro_trans('common.edit') }}</a></td></tr>{% else %}<tr><td colspan="4" class="empty">{{ shopro_trans('membership.empty') }}</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
