{% extends 'cms/layout.html.twig' %}

{% block title %}{{ page.effectiveSeoTitle }} — Shopro 4.0{% endblock %}
{% block meta %}<meta name="description" content="{{ page.description }}"><meta name="keywords" content="{{ page.keywords }}"><meta name="robots" content="{{ page.follow ? 'index, follow' : 'index, nofollow' }}">{% if page.canonical %}<link rel="canonical" href="{{ page.canonical }}">{% endif %}{{ page.meta|raw }}{% endblock %}
{% block stylesheets %}{{ parent() }}{% if page.builderCss %}<style>{{ page.builderCss|raw }}</style>{% endif %}{% endblock %}

{% block page_content %}
<section class="public-page-hero">
    <div class="public-page-hero__orb"></div>
    <div class="site-container">
        <nav class="public-breadcrumb" aria-label="Okruszki">
            <a href="{{ path('app_home') }}">Strona główna</a><span>›</span><span>{{ page.title }}</span>
        </nav>
        <span class="site-kicker">SHOPRO 4.0</span>
        <h1>{{ page.title }}</h1>
        <p>{{ page.caption ?: 'Informacje i materiały przygotowane dla użytkowników Shopro.' }}</p>
    </div>
</section>

<section class="public-page-content">
    <div class="site-container public-page-grid">
        <article class="public-article">
            <div class="public-article__body">{{ page.content|raw }}</div>
        </article>
        <aside class="public-page-aside">
            <div><span class="site-kicker">SHOPRO CMS</span><h2>Potrzebujesz pomocy?</h2><p>Skontaktuj się z nami, jeśli potrzebujesz dodatkowych informacji.</p><a class="site-button" href="{{ path('app_home') }}#kontakt">Kontakt <span>→</span></a></div>
            <a class="public-back-link" href="{{ path('app_home') }}">← Wróć na stronę główną</a>
        </aside>
    </div>
</section>
{% endblock %}
{% block page_javascript %}{% if page.javascript %}<script>{{ page.javascript|raw }}</script>{% endif %}{% endblock %}
