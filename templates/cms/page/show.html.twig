{% extends 'cms/layout.html.twig' %}

{% block title %}{{ page.effectiveSeoTitle }} — Shopro 4.0{% endblock %}
{% block header_modifier %}{% if not (page.usesComponentBuilder and page.homePage) %} site-header--solid{% endif %}{% endblock %}
{% block meta %}<meta name="description" content="{{ page.description }}"><meta name="keywords" content="{{ page.keywords }}"><meta name="robots" content="{{ page.follow ? 'index, follow' : 'index, nofollow' }}">{% if page.canonical %}<link rel="canonical" href="{{ page.canonical }}">{% endif %}{% set default_language=shopro_default_language() %}<link rel="alternate" hreflang="x-default" href="{{ absolute_url(path('cms_page_show',{slug:source_page.slug})) }}">{% if default_language %}<link rel="alternate" hreflang="{{ default_language.code }}" href="{{ absolute_url(path('cms_page_show',{slug:source_page.slug})) }}">{% endif %}{% for alternate in alternates %}<link rel="alternate" hreflang="{{ alternate.language.code }}" href="{{ absolute_url(path('cms_page_show_localized',{_locale:alternate.language.code,slug:alternate.slug})) }}">{% endfor %}{{ page.meta|raw }}{% endblock %}
{% block stylesheets %}{{ parent() }}{% endblock %}

{% block page_content %}
{% if page.usesComponentBuilder %}
    {% for block in page.builderBlocks %}
        {% include 'cms/block/_render.html.twig' with {component: block} only %}
    {% else %}
        <section class="site-section"><div class="site-container"><p>{{ shopro_trans('page.no_content') }}</p></div></section>
    {% endfor %}
{% else %}
<section class="public-page-hero">
    <div class="public-page-hero__orb"></div>
    <div class="site-container">
        {% if shopro_setting('show_breadcrumbs', true) %}<nav class="public-breadcrumb" aria-label="Okruszki">
            <a href="{{ path('app_home') }}">{{ shopro_trans('front.home') }}</a><span>›</span><span>{{ page.title }}</span>
        </nav>{% endif %}
        <span class="site-kicker">SHOPRO 4.0</span>
        <h1>{{ page.title }}</h1>
        <p>{{ page.caption ?: 'Informacje i materiały przygotowane dla użytkowników Shopro.' }}</p>
    </div>
</section>

<section class="public-page-content">
    <div class="site-container public-page-grid">
        <article class="public-article">
            <div class="public-article__body">{{ page.content|raw }}</div>
        </article>
        <aside class="public-page-aside">
            <div><span class="site-kicker">SHOPRO CMS</span><h2>{{ shopro_trans('front.need_help') }}</h2><p>Skontaktuj się z nami, jeśli potrzebujesz dodatkowych informacji.</p><a class="site-button" href="{{ path('app_home') }}#kontakt">{{ shopro_trans('front.contact') }} <span>→</span></a></div>
            <a class="public-back-link" href="{{ path('app_home') }}">← {{ shopro_trans('front.back_home') }}</a>
        </aside>
    </div>
</section>
{% endif %}
{% endblock %}
{% block page_javascript %}{% if page.javascript %}<script>{{ page.javascript|raw }}</script>{% endif %}{% endblock %}
