{% extends 'cms/layout.html.twig' %}

{% block title %}{{ page.effectiveSeoTitle }} — {{ shopro_setting('site_name', 'Shopro 4.0') }}{% endblock %}
{% block header_modifier %}{% if not (page.usesComponentBuilder and page.homePage) %} site-header--solid{% endif %}{% endblock %}
{% block meta %}
{% set seo_description = page.description ?: shopro_setting('meta_description') %}
{% set seo_url = page.canonical ?: absolute_url(app.request.pathInfo) %}
{% set site_name = shopro_setting('site_name', 'Shopro 4.0') %}
<meta name="description" content="{{ seo_description }}">
{% if page.keywords %}<meta name="keywords" content="{{ page.keywords }}">{% endif %}
<meta name="robots" content="{{ preview|default(false) ? 'noindex, nofollow' : (page.follow ? 'index, follow' : 'index, nofollow') }}">
{% if not preview|default(false) %}
<link rel="canonical" href="{{ seo_url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site_name }}">
<meta property="og:title" content="{{ page.effectiveSeoTitle }}">
<meta property="og:description" content="{{ seo_description }}">
<meta property="og:url" content="{{ seo_url }}">
<meta property="og:locale" content="{{ shopro_language() ? shopro_language().locale|replace({'-':'_'}) : app.request.locale|replace({'-':'_'}) }}">
{% set social_image = shopro_setting('social_image') %}
{% if social_image %}<meta property="og:image" content="{{ absolute_url(social_image) }}"><meta property="og:image:alt" content="{{ page.effectiveSeoTitle }}">{% endif %}
<meta name="twitter:card" content="{{ social_image ? 'summary_large_image' : 'summary' }}">
<meta name="twitter:title" content="{{ page.effectiveSeoTitle }}">
<meta name="twitter:description" content="{{ seo_description }}">
{% if social_image %}<meta name="twitter:image" content="{{ absolute_url(social_image) }}">{% endif %}
{% set source=source_page|default(page) %}
{% set default_language=shopro_default_language() %}
<link rel="alternate" hreflang="x-default" href="{{ absolute_url(source.homePage ? path('app_home') : path('cms_page_show',{slug:source.slug})) }}">
{% if default_language %}<link rel="alternate" hreflang="{{ default_language.code }}" href="{{ absolute_url(source.homePage ? path('app_home') : path('cms_page_show',{slug:source.slug})) }}">{% endif %}
{% for alternate in alternates|default([]) %}<link rel="alternate" hreflang="{{ alternate.language.code }}" href="{{ absolute_url(path('cms_page_show_localized',{_locale:alternate.language.code,slug:alternate.slug})) }}">{% endfor %}
{% set home_url = absolute_url(path('app_home')) %}
{% set organization = {'@type':'Organization','@id':home_url ~ '#organization','name':shopro_setting('company') ?: site_name,'url':home_url} %}
{% if shopro_setting('site_logo') %}{% set organization = organization|merge({'logo':absolute_url(shopro_setting('site_logo'))}) %}{% endif %}
{% set schema = {'@context':'https://schema.org','@graph':[organization,{'@type':'WebPage','@id':seo_url ~ '#webpage','url':seo_url,'name':page.effectiveSeoTitle,'description':seo_description,'isPartOf':{'@id':home_url ~ '#website'},'about':{'@id':home_url ~ '#organization'},'inLanguage':shopro_language() ? shopro_language().locale : app.request.locale},{'@type':'WebSite','@id':home_url ~ '#website','url':home_url,'name':site_name,'publisher':{'@id':home_url ~ '#organization'}}]} %}
<script type="application/ld+json">{{ schema|json_encode|raw }}</script>
{% endif %}
{{ page.meta|raw }}
{% endblock %}
{% block stylesheets %}{{ parent() }}{% endblock %}

{% block page_content %}
{% if preview|default(false) %}<div class="page-preview-banner"><strong>{{ shopro_trans('page.preview_mode') }}</strong><span>{{ shopro_trans('page.preview_not_saved') }}</span></div>{% endif %}
{% if page.usesComponentBuilder %}
    {% for block in page.builderBlocks %}
        {% include 'cms/block/_render.html.twig' with {component: block} only %}
    {% else %}
        <section class="site-section"><div class="site-container"><p>{{ shopro_trans('page.no_content') }}</p></div></section>
    {% endfor %}
{% else %}
<section class="public-page-hero">
    <div class="public-page-hero__orb"></div>
    <div class="site-container">
        {% if shopro_setting('show_breadcrumbs', true) %}<nav class="public-breadcrumb" aria-label="Okruszki">
            <a href="{{ path('app_home') }}">{{ shopro_trans('front.home') }}</a><span>›</span><span>{{ page.title }}</span>
        </nav>{% endif %}
        <span class="site-kicker">SHOPRO 4.0</span>
        <h1>{{ page.title }}</h1>
        <p>{{ page.caption ?: shopro_trans('front.page_caption') }}</p>
    </div>
</section>

<section class="public-page-content">
    <div class="site-container public-page-grid">
        <article class="public-article">
            <div class="public-article__body">{{ page.content|raw }}</div>
        </article>
        <aside class="public-page-aside">
            <div><span class="site-kicker">SHOPRO CMS</span><h2>{{ shopro_trans('front.need_help') }}</h2><p>{{ shopro_trans('front.help_text') }}</p><a class="site-button" href="{{ path('app_home') }}#kontakt">{{ shopro_trans('front.contact') }} <span>→</span></a></div>
            <a class="public-back-link" href="{{ path('app_home') }}">← {{ shopro_trans('front.back_home') }}</a>
        </aside>
    </div>
</section>
{% endif %}
{% endblock %}
{% block page_javascript %}{% if page.javascript %}<script>{{ page.javascript|raw }}</script>{% endif %}{% endblock %}
