{% set configured_logo = shopro_setting('site_logo') %}
{% set fallback_logo = asset('branding/shopro-logo.svg') %}
<a class="site-brand" href="{{ href|default(path('app_home')) }}" aria-label="{{ shopro_setting('site_name', 'Shopro 4.0') }}">
    <img class="site-brand__image" src="{{ configured_logo ?: fallback_logo }}" alt="{{ shopro_setting('site_name', 'Shopro 4.0') }}"{% if configured_logo and configured_logo != fallback_logo %} onerror="this.onerror=null;this.src='{{ fallback_logo|e('js') }}'"{% endif %}>
</a>
