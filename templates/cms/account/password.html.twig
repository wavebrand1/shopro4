{% extends 'cms/layout.html.twig' %}
{% block title %}{{ shopro_trans('site_account.change_password') }} — Shopro 4.0{% endblock %}
{% block page_content %}<section class="site-section"><div class="site-container"><div class="modern-login-card site-account-card"><p class="modern-kicker">{{ shopro_trans('site_auth.account') }}</p><h1>{{ shopro_trans('site_account.change_password') }}</h1><p class="modern-login-lead">{{ shopro_trans('auth.set_new_password_help') }}</p>{% if error %}<div class="flash flash--error">{{ shopro_trans(error) }}</div>{% endif %}{{ form_start(form,{attr:{class:'admin-form modern-login-form'}}) }}{{ form_row(form.currentPassword) }}{{ form_row(form.newPassword) }}<button class="modern-button modern-button--primary modern-button--wide">{{ shopro_trans('auth.save_new_password') }}</button>{{ form_end(form) }}<a class="modern-login-footer" href="{{ shopro_system_page_url('account') }}">← {{ shopro_trans('common.back') }}</a></div></div></section>{% endblock %}
