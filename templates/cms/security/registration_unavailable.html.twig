{% extends 'cms/layout.html.twig' %}
{% block title %}{{ shopro_trans('site_registration.unavailable') }} — Shopro 4.0{% endblock %}
{% block page_content %}
<section class="site-section">
    <div class="site-container">
        <div class="modern-login-card site-account-card">
            <p class="modern-kicker">404</p>
            <h1>{{ shopro_trans('site_registration.unavailable') }}</h1>
            <p class="modern-login-lead">{{ shopro_trans(message|default('site_registration.disabled')) }}</p>
            <a class="modern-button modern-button--primary" href="{{ path('app_home') }}">{{ shopro_trans('front.back_home') }}</a>
        </div>
    </div>
</section>
{% endblock %}
