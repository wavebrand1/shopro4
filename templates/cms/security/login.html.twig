{% extends 'cms/layout.html.twig' %}
{% block title %}{{ shopro_trans('site_auth.login_title') }} — Shopro 4.0{% endblock %}
{% block page_content %}
<section class="site-section"><div class="site-container"><div class="modern-login-card site-account-card">
    <p class="modern-kicker">{{ shopro_trans('site_auth.account') }}</p>
    <h1>{{ shopro_trans('site_auth.login_title') }}</h1>
    <p class="modern-login-lead">{{ shopro_trans('site_auth.login_help') }}</p>
    {% if error %}<div class="flash flash--error">{{ shopro_trans('auth.invalid_credentials') }}</div>{% endif %}
    <form method="post" class="admin-form modern-login-form">
        <label>{{ shopro_trans('auth.identifier') }}<input type="text" name="_username" value="{{ last_username }}" required autofocus autocomplete="username"></label>
        <label>{{ shopro_trans('auth.password') }}<input type="password" name="_password" required autocomplete="current-password"></label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('site_authenticate') }}">
        <button class="modern-button modern-button--primary modern-button--wide" type="submit">{{ shopro_trans('auth.sign_in') }}</button>
    </form>
    <a class="modern-login-footer" href="{{ path('site_password_forgot') }}">{{ shopro_trans('auth.forgot_password_link') }}</a>
    {% if shopro_setting('registration_allowed', false) %}
        <a class="modern-login-footer" href="{{ path('site_register') }}">{{ shopro_trans('site_registration.create_account') }}</a>
    {% endif %}
</div></div></section>
{% endblock %}
