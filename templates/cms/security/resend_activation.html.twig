{% extends 'cms/layout.html.twig' %}
{% block title %}{{ shopro_trans('site_registration.resend_title') }} — Shopro 4.0{% endblock %}
{% block page_content %}<section class="site-section"><div class="site-container"><div class="modern-login-card site-account-card"><p class="modern-kicker">{{ shopro_trans('site_auth.account') }}</p><h1>{{ shopro_trans('site_registration.resend_title') }}</h1><p class="modern-login-lead">{{ shopro_trans('site_registration.resend_help') }}</p>{% if sent %}<div class="flash flash--success">{{ shopro_trans('site_registration.resend_sent') }}</div>{% else %}<form method="post" class="admin-form modern-login-form"><label>{{ shopro_trans('auth.identifier') }}<input type="text" name="identifier" required autofocus autocomplete="username"></label><input type="hidden" name="_token" value="{{ csrf_token('site-activation-resend') }}"><button class="modern-button modern-button--primary modern-button--wide">{{ shopro_trans('site_registration.resend_submit') }}</button></form>{% endif %}<a class="modern-login-footer" href="{{ path('site_login') }}">← {{ shopro_trans('auth.back_to_login') }}</a></div></div></section>{% endblock %}
