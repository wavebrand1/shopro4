<section class="site-section site-section--soft" id="{{ block.anchor|default('jak-dziala') }}"><div class="site-container site-process">
    <div class="site-process__visual"><div class="process-window"><div class="process-window__bar"><i></i><i></i><i></i></div><div class="process-window__body"><aside><b></b><span></span><span></span><span></span></aside><main><small>{{ block.previewKicker|default(shopro_trans('front.preview_your_system')) }}</small><strong>{{ block.previewTitle|default(shopro_trans('front.preview_easy')) }}<br>{{ block.previewSubtitle|default(shopro_trans('front.preview_ready')) }}</strong><div><i></i><i></i><i></i></div></main></div></div></div>
    <div class="site-process__content"><span class="site-kicker">{{ block.kicker|default('') }}</span><h2>{{ block.heading|default('') }}{% if block.highlight|default('') %}<br><em>{{ block.highlight }}</em>{% endif %}</h2><p>{{ block.text|default('') }}</p><ol>{% for item in block.items|default([]) %}<li><span>{{ item.number|default(loop.index) }}</span><div><strong>{{ item.title|default('') }}</strong><small>{{ item.text|default('') }}</small></div></li>{% endfor %}</ol></div>
</div></section>
