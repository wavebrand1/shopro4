{% set columns = block.columns|default(3) %}
<section class="site-section" id="{{ block.anchor|default('mozliwosci') }}">
    <div class="site-container">
        <div class="site-section-heading"><div><span class="site-kicker">{{ block.kicker|default('MOŻLIWOŚCI') }}</span><h2>{{ block.heading|default('') }}{% if block.highlight|default('') %}<br><em>{{ block.highlight }}</em>{% endif %}</h2></div><p>{{ block.lead|default('') }}</p></div>
        <div class="site-features site-features--{{ columns }}">
            {% for card in block.items|default([]) %}
                {% set color = card.color|default('blue') in ['blue', 'green', 'orange', 'purple'] ? card.color : 'blue' %}
                <article><span class="feature-icon feature-icon--{{ color }}">{{ card.icon|default('document') == 'command' ? '⌘' : (card.icon|default('document') == 'target' ? '◎' : (card.icon|default('document') == 'star' ? '☆' : '▤')) }}</span><h3>{{ card.title|default('') }}</h3><p>{{ card.text|default('') }}</p>
                {% set url = card.url|default('') %}{% if card.buttonLabel|default('') and (url starts with '/' or url starts with '#' or url starts with 'https://' or url starts with 'http://' or url starts with 'mailto:' or url starts with 'tel:') %}<a href="{{ url }}">{{ card.buttonLabel }} →</a>{% endif %}</article>
            {% endfor %}
        </div>
    </div>
</section>
