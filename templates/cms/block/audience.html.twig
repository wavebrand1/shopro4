<section class="site-section" id="{{ block.anchor|default('dla-kogo') }}"><div class="site-container"><div class="site-centered-heading"><span class="site-kicker">{{ block.kicker|default('') }}</span><h2>{{ block.heading|default('') }}{% if block.highlight|default('') %}<br><em>{{ block.highlight }}</em>{% endif %}</h2><p>{{ block.text|default('') }}</p></div><div class="site-audience">{% for item in block.items|default([]) %}<article><strong>{{ item.number|default(loop.index) }}</strong><h3>{{ item.title|default('') }}</h3><p>{{ item.text|default('') }}</p></article>{% endfor %}</div></div></section>
