{% set primaryUrl = block.primaryUrl|default('#') %}{% set secondaryUrl = block.secondaryUrl|default('#') %}
<section class="site-cta" id="{{ block.anchor|default('kontakt') }}"><div class="site-container"><div class="site-cta__inner"><div><span class="site-kicker">{{ block.kicker|default('') }}</span><h2>{{ block.heading|default('') }}{% if block.headingAfter|default('') %}<br>{{ block.headingAfter }}{% endif %}</h2><p>{{ block.text|default('') }}</p></div><div class="site-cta__actions">{% if block.primaryLabel|default('') and (primaryUrl starts with '/' or primaryUrl starts with '#' or primaryUrl starts with 'https://' or primaryUrl starts with 'http://' or primaryUrl starts with 'mailto:' or primaryUrl starts with 'tel:') %}<a class="site-button site-button--light" href="{{ primaryUrl }}">{{ block.primaryLabel }} <span>→</span></a>{% endif %}{% if block.secondaryLabel|default('') and (secondaryUrl starts with '/' or secondaryUrl starts with '#' or secondaryUrl starts with 'https://' or secondaryUrl starts with 'http://' or secondaryUrl starts with 'mailto:' or secondaryUrl starts with 'tel:') %}<a href="{{ secondaryUrl }}">{{ block.secondaryLabel }}</a>{% endif %}</div></div></div></section>
