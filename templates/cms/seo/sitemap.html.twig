{% extends 'cms/layout.html.twig' %}
{% block title %}{{ shopro_trans('sitemap.title') }} — Shopro 4.0{% endblock %}
{% block page_content %}
<section class="site-section">
    <div class="site-container site-sitemap">
        <span class="site-kicker">{{ shopro_trans('sitemap.kicker') }}</span>
        <h1>{{ shopro_trans('sitemap.title') }}</h1>
        <p>{{ shopro_trans('sitemap.lead') }}</p>
        {% if entries %}
            <ul class="site-sitemap__list">
                {% for entry in entries %}
                    <li><a href="{{ entry.url }}">{{ entry.title }}</a></li>
                {% endfor %}
            </ul>
        {% else %}
            <p>{{ shopro_trans('sitemap.empty') }}</p>
        {% endif %}
    </div>
</section>
{% endblock %}
