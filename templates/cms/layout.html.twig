{% extends 'base.html.twig' %}

{% block body_class %}site-body{% endblock %}

{% block body %}
<div class="site-shell">
    <header class="site-header{% block header_modifier %} site-header--solid{% endblock %}">
        <div class="site-container site-header__inner">
            <a class="site-brand" href="{{ path('app_home') }}"><span class="site-brand__logo">S</span><span>Shopro <b>4.0</b></span></a>
            <nav class="site-nav" id="site-navigation" aria-label="Menu główne">
                {% import 'cms/_menu.html.twig' as menu %}
                {% set header_menu = shopro_menu(1) %}
                {% if header_menu %}{{ menu.render(header_menu) }}{% else %}<a href="{{ path('app_home') }}#mozliwosci">Możliwości</a><a href="{{ path('app_home') }}#jak-dziala">Jak działa</a><a href="{{ path('app_home') }}#dla-kogo">Dla kogo</a><a href="{{ path('app_home') }}#kontakt">Kontakt</a>{% endif %}
            </nav>
            <div class="site-header__actions">
                {% if shopro_setting('show_search', true) %}<a class="site-search-link" href="{{ path('app_home') }}?q=" aria-label="Szukaj">⌕</a>{% endif %}
                {% if shopro_setting('show_language', false) %}<span class="site-language">{{ shopro_setting('language', 'pl')|upper }}</span>{% endif %}
                {% if shopro_setting('show_login', true) %}<a class="site-login-link" href="{{ path('admin_dashboard') }}">Zaloguj się</a>{% endif %}
                <a class="site-button site-button--small" href="{{ path('app_home') }}#kontakt">Rozpocznij</a>
                <button class="site-menu-toggle" type="button" data-site-menu aria-label="Otwórz menu"><span></span><span></span><span></span></button>
            </div>
        </div>
    </header>

    <main>{% block page_content %}{% endblock %}</main>

    <footer class="site-footer">
        <div class="site-container site-footer__grid">
            <a class="site-brand" href="{{ path('app_home') }}"><span class="site-brand__logo">S</span><span>Shopro <b>4.0</b></span></a>
            <p>Nowoczesny, modułowy system zarządzania firmą.</p>
            <div>{% set footer_menu = shopro_menu(0) %}{% for item in footer_menu %}{% if item.url %}<a href="{{ item.url }}" target="{{ item.target }}">{{ item.name }}</a>{% endif %}{% else %}<a href="{{ path('app_home') }}#mozliwosci">Możliwości</a><a href="{{ path('app_home') }}#jak-dziala">Jak działa</a><a href="{{ path('admin_dashboard') }}">Panel</a>{% endfor %}</div>
        </div>
        <div class="site-container site-footer__bottom"><span>© {{ 'now'|date('Y') }} Wavebrand. Wszystkie prawa zastrzeżone.</span><span>Symfony 7.4 LTS</span></div>
    </footer>
</div>
{% endblock %}
