{% set current_language = shopro_language() %}<!doctype html><html lang="{{ current_language ? current_language.code : 'pl' }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{ shopro_trans('maintenance.title') }} — {{ shopro_setting('site_name') }}</title><link rel="stylesheet" href="{{ asset('styles/app.css') }}"></head>
<body class="maintenance-page"><main><span class="site-brand__logo">S</span><p class="modern-kicker">{{ shopro_trans('maintenance.kicker') }}</p><h1>{{ shopro_trans('maintenance.heading') }}</h1><p>{{ message }}</p>{% if date %}<small>{{ shopro_trans('maintenance.ends') }} {{ date }}{% if time %}, {{ time }}{% endif %}</small>{% endif %}</main></body></html>
