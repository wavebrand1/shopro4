#!/usr/bin/env bash

set -Eeuo pipefail

trap 'status=$?; echo "[Shopro theme] Deployment failed at line $LINENO (exit $status)" >&2; exit $status' ERR

cd "$(dirname "$0")/.."

DEPLOY_ENV="${SHOPRO_DEPLOY_ENV:-prod}"
DEPLOY_DEBUG="${SHOPRO_DEPLOY_DEBUG:-0}"
PHP_BIN="${SHOPRO_PHP_BIN:-}"

for candidate in /opt/plesk/php/8.3/bin/php /opt/plesk/php/8.4/bin/php /opt/plesk/php/8.5/bin/php /opt/plesk/php/8.2/bin/php /usr/bin/php; do
    if [ -n "$PHP_BIN" ]; then
        break
    fi
    if [ -x "$candidate" ]; then
        PHP_BIN="$candidate"
        break
    fi
done

if [ -z "$PHP_BIN" ] || [ ! -x "$PHP_BIN" ]; then
    echo "[Shopro theme] PHP binary was not found: ${PHP_BIN:-not configured}" >&2
    exit 1
fi

export PATH="$(dirname "$PHP_BIN"):$PATH"
export APP_ENV="$DEPLOY_ENV"
export APP_DEBUG="$DEPLOY_DEBUG"

echo "[Shopro theme] Using PHP: $PHP_BIN ($DEPLOY_ENV, debug=$DEPLOY_DEBUG)"

# In a Git deployment update the installed theme first. During a temporary FTP
# test set SHOPRO_THEME_SYNC=0, otherwise the synchronizer could replace the
# uploaded files with the revision declared in the theme manifest.
if [ "${SHOPRO_THEME_SYNC:-1}" = "1" ]; then
    COMPOSER_BIN="${SHOPRO_COMPOSER_BIN:-$(command -v composer || true)}"
    if [ -z "$COMPOSER_BIN" ]; then
        echo "[Shopro theme] Composer executable was not found" >&2
        exit 1
    fi

    SHOPRO_PHP_BIN="$PHP_BIN" \
    SHOPRO_COMPOSER_BIN="$COMPOSER_BIN" \
    bash bin/sync-installed-themes
else
    echo "[Shopro theme] Theme repository synchronization skipped (FTP test mode)"
fi

echo "[Shopro theme] Synchronizing PageBuilder content"
"$PHP_BIN" bin/console app:themes:sync-content --env="$DEPLOY_ENV" --no-debug

echo "[Shopro theme] Publishing bundle assets"
"$PHP_BIN" bin/console assets:install public --env="$DEPLOY_ENV" --no-debug
"$PHP_BIN" bin/console importmap:install --env="$DEPLOY_ENV" --no-debug

# AssetMapper fingerprints files into public/assets. Remove only that generated
# output so obsolete hashes cannot remain available after a CSS/JS update.
if [ -d public/assets ]; then
    find public/assets -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
fi

echo "[Shopro theme] Compiling fingerprinted assets"
"$PHP_BIN" bin/console asset-map:compile --env="$DEPLOY_ENV" --no-debug

# The web server must be able to read files generated by the deployment user.
chmod -R a+rX public/assets public/bundles

MANIFEST="public/assets/manifest.json"
if [ ! -s "$MANIFEST" ]; then
    echo "[Shopro theme] Asset manifest was not generated: $MANIFEST" >&2
    exit 1
fi

# Verify the published bundle copies against the installed package.
for asset in theme.css theme.js page-builder.js; do
    SOURCE="vendor/wavebrand/shopro-theme-fotograf-trzciana/public/$asset"
    PUBLISHED="public/bundles/shoprothemefotograftrzciana/$asset"
    if [ ! -s "$SOURCE" ] || [ ! -s "$PUBLISHED" ] || ! cmp -s "$SOURCE" "$PUBLISHED"; then
        echo "[Shopro theme] Bundle asset is missing or stale: $PUBLISHED" >&2
        exit 1
    fi
done

"$PHP_BIN" bin/console app:theme-images:optimize --env="$DEPLOY_ENV" --no-debug
"$PHP_BIN" bin/console cache:clear --env="$DEPLOY_ENV" --no-debug

echo "[Shopro theme] Current compiled theme assets:"
"$PHP_BIN" -r '$m=json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR); foreach ($m as $logical => $entry) { if (str_contains((string) $logical, "shoprothemefotograftrzciana")) { $path=is_array($entry) ? ($entry["path"] ?? "") : $entry; echo $logical, " -> ", $path, PHP_EOL; } }' "$MANIFEST"

echo "[Shopro theme] Deployment completed"
