#!/usr/bin/env bash

# Restores customer-owned theme packages after a Core deployment. The manifest
# intentionally lives outside httpdocs, so Plesk's Git deployment cannot
# overwrite it together with composer.json.
set -Eeuo pipefail

cd "$(dirname "$0")/.."

PHP_BIN="${SHOPRO_PHP_BIN:-php}"
COMPOSER_BIN="${SHOPRO_COMPOSER_BIN:-composer}"
MANIFEST="${SHOPRO_THEME_MANIFEST:-$(cd .. && pwd)/shopro-themes/installed.json}"
DEFAULT_DEV_THEME_PATH="themes/shopro-theme-atena-fit"
DEFAULT_DEV_THEME_REPOSITORY="https://github.com/wavebrand1/shopro-theme-atena-fit.git"

# The Core composer.json references the default Atena theme as a path package.
# Restore that source before the first Composer operation on dev deployments.
if [ "${SHOPRO_DEPLOY_ENV:-dev}" != "prod" ]; then
    if ! command -v git >/dev/null 2>&1; then
        echo "[Shopro themes] Git was not found" >&2
        exit 1
    fi
    if [ ! -e "$DEFAULT_DEV_THEME_PATH" ]; then
        echo "[Shopro themes] Cloning the default Atena theme"
        mkdir -p "$(dirname "$DEFAULT_DEV_THEME_PATH")"
        git clone --branch main --single-branch "$DEFAULT_DEV_THEME_REPOSITORY" "$DEFAULT_DEV_THEME_PATH"
    elif [ ! -d "$DEFAULT_DEV_THEME_PATH/.git" ]; then
        echo "[Shopro themes] Default theme path is not a Git repository: $DEFAULT_DEV_THEME_PATH" >&2
        exit 1
    elif [ -n "$(git -C "$DEFAULT_DEV_THEME_PATH" status --porcelain)" ]; then
        echo "[Shopro themes] Refusing to update the default theme with local changes" >&2
        exit 1
    else
        current_remote="$(git -C "$DEFAULT_DEV_THEME_PATH" remote get-url origin)"
        if [ "$current_remote" != "$DEFAULT_DEV_THEME_REPOSITORY" ]; then
            echo "[Shopro themes] Default theme repository URL mismatch" >&2
            exit 1
        fi
        echo "[Shopro themes] Updating the default Atena theme"
        git -C "$DEFAULT_DEV_THEME_PATH" fetch --prune origin main
        git -C "$DEFAULT_DEV_THEME_PATH" merge --ff-only FETCH_HEAD
    fi
fi

if [ "${SHOPRO_THEME_PREPARE_ONLY:-0}" = "1" ]; then
    echo "[Shopro themes] Theme sources are ready"
    exit 0
fi

if [ ! -f "$MANIFEST" ]; then
    echo "[Shopro themes] No external theme manifest found; using bundled themes only"
    exit 0
fi

if ! command -v "$PHP_BIN" >/dev/null 2>&1; then
    echo "[Shopro themes] PHP CLI was not found: $PHP_BIN" >&2
    exit 1
fi

if ! command -v "$COMPOSER_BIN" >/dev/null 2>&1; then
    echo "[Shopro themes] Composer was not found: $COMPOSER_BIN" >&2
    exit 1
fi

mapfile -t THEMES < <("$PHP_BIN" -r '
    $manifest = $argv[1];
    $data = json_decode((string) file_get_contents($manifest), true, 512, JSON_THROW_ON_ERROR);
    foreach (($data["themes"] ?? []) as $theme) {
        if (!is_array($theme) || !isset($theme["package"], $theme["path"])) {
            throw new RuntimeException("Every theme requires package and path.");
        }
        $constraint = (string) ($theme["constraint"] ?? "*@dev");
        echo $theme["package"], "\t", $theme["path"], "\t", $constraint, PHP_EOL;
    }
' "$MANIFEST")

if [ "${#THEMES[@]}" -eq 0 ]; then
    echo "[Shopro themes] Manifest contains no customer themes"
    exit 0
fi

for index in "${!THEMES[@]}"; do
    IFS=$'\t' read -r package path constraint <<< "${THEMES[$index]}"
    if [ -z "$package" ] || [ -z "$path" ]; then
        echo "[Shopro themes] Invalid theme manifest entry" >&2
        exit 1
    fi

    # A path repository keeps customer source outside the Core checkout while
    # Composer/Flex registers its Symfony bundle in the current application.
    echo "[Shopro themes] Synchronizing $package"
    "$COMPOSER_BIN" config --no-interaction "repositories.shopro_theme_$index" path "$path"
    "$COMPOSER_BIN" require "$package:$constraint" --no-interaction --no-progress --no-scripts
done
