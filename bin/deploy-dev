#!/usr/bin/env bash

set -Eeuo pipefail

trap 'status=$?; echo "[Shopro] Deployment failed at line $LINENO (exit $status)" >&2; exit $status' ERR

cd "$(dirname "$0")/.."

PHP_BIN=""
for candidate in /opt/plesk/php/8.3/bin/php /opt/plesk/php/8.2/bin/php /usr/bin/php; do
    if [ -x "$candidate" ]; then
        PHP_BIN="$candidate"
        break
    fi
done

if [ -z "$PHP_BIN" ]; then
    echo "[Shopro] PHP binary was not found" >&2
    exit 1
fi

# Plesk runs Git deployment hooks with a minimal PATH. Composer and Symfony
# recipes use `#!/usr/bin/env php`, so expose the selected Plesk PHP to every
# child process as well.
export PATH="$(dirname "$PHP_BIN"):$PATH"

if ! command -v php >/dev/null 2>&1; then
    echo "[Shopro] PHP is not available in deployment PATH" >&2
    exit 1
fi

COMPOSER_BIN="$(command -v composer || true)"
if [ -z "$COMPOSER_BIN" ]; then
    echo "[Shopro] Composer executable was not found" >&2
    exit 1
fi

echo "[Shopro] Using PHP: $PHP_BIN"

echo "[Shopro] Installing Composer dependencies"
# On Plesk, `composer` can be a phpenv shell shim rather than a PHP/PHAR file.
# It must therefore be executed directly instead of being passed to PHP.
# Symfony auto-scripts may boot the new application. They must not run before
# migrations required by that version of the code have completed.
"$COMPOSER_BIN" install --prefer-dist --no-interaction --no-progress --no-scripts

if [ ! -f vendor/symfony/html-sanitizer/HtmlSanitizer.php ]; then
    echo "[Shopro] Composer did not install symfony/html-sanitizer" >&2
    exit 1
fi

echo "[Shopro] Running database migrations"
APP_ENV=dev APP_DEBUG=1 "$PHP_BIN" bin/console doctrine:migrations:migrate --no-interaction

echo "[Shopro] Validating Doctrine mapping"
APP_ENV=dev APP_DEBUG=1 "$PHP_BIN" bin/console doctrine:schema:validate --skip-sync

echo "[Shopro] Synchronizing system translations"
APP_ENV=dev APP_DEBUG=1 "$PHP_BIN" bin/console app:translations:sync

echo "[Shopro] Installing bundle assets"
APP_ENV=dev APP_DEBUG=1 "$PHP_BIN" bin/console assets:install public

echo "[Shopro] Installing importmap vendor assets"
APP_ENV=dev APP_DEBUG=1 "$PHP_BIN" bin/console importmap:install

echo "[Shopro] Compiling AssetMapper assets"
APP_ENV=dev APP_DEBUG=1 "$PHP_BIN" bin/console asset-map:compile

echo "[Shopro] Generating responsive image variants"
APP_ENV=dev APP_DEBUG=1 "$PHP_BIN" bin/console app:images:optimize

# Cache must be cleared after compilation so that Symfony discovers the
# freshly generated manifest instead of retaining old asset URLs.
echo "[Shopro] Clearing Symfony cache"
APP_ENV=dev APP_DEBUG=1 "$PHP_BIN" bin/console cache:clear

echo "[Shopro] Ensuring newsletter queue worker is scheduled"
bash bin/setup-queue-worker --install-only || echo "[Shopro] Cron unavailable; configure the worker in Plesk Scheduled Tasks"
echo "[Shopro] Processing messages already waiting in the queue"
bash bin/setup-queue-worker --drain-only || echo "[Shopro] Queue is already being processed or the mail transport needs attention"

echo "[Shopro] Development deployment completed"
