#!/usr/bin/env bash

set -Eeuo pipefail

trap 'status=$?; echo "[Shopro] Deployment failed at line $LINENO (exit $status)" >&2; exit $status' ERR

cd "$(dirname "$0")/.."

DEPLOY_ENV="${SHOPRO_DEPLOY_ENV:-dev}"
DEPLOY_DEBUG="${SHOPRO_DEPLOY_DEBUG:-}"
if [ -z "$DEPLOY_DEBUG" ]; then
    if [ "$DEPLOY_ENV" = "prod" ]; then DEPLOY_DEBUG=0; else DEPLOY_DEBUG=1; fi
fi

PHP_BIN=""
for candidate in /opt/plesk/php/8.3/bin/php /opt/plesk/php/8.2/bin/php /usr/bin/php; do
    if [ -x "$candidate" ]; then
        PHP_BIN="$candidate"
        break
    fi
done

if [ -z "$PHP_BIN" ]; then
    echo "[Shopro] PHP binary was not found" >&2
    exit 1
fi

# Plesk runs Git deployment hooks with a minimal PATH. Composer and Symfony
# recipes use `#!/usr/bin/env php`, so expose the selected Plesk PHP to every
# child process as well.
export PATH="$(dirname "$PHP_BIN"):$PATH"

if ! command -v php >/dev/null 2>&1; then
    echo "[Shopro] PHP is not available in deployment PATH" >&2
    exit 1
fi

COMPOSER_BIN="$(command -v composer || true)"
if [ -z "$COMPOSER_BIN" ]; then
    echo "[Shopro] Composer executable was not found" >&2
    exit 1
fi

echo "[Shopro] Using PHP: $PHP_BIN ($DEPLOY_ENV, debug=$DEPLOY_DEBUG)"

echo "[Shopro] Synchronizing externally installed customer themes"
SHOPRO_PHP_BIN="$PHP_BIN" SHOPRO_COMPOSER_BIN="$COMPOSER_BIN" SHOPRO_DEPLOY_ENV="$DEPLOY_ENV" bash bin/sync-installed-themes

echo "[Shopro] Synchronizing installed modules"
SHOPRO_PHP_BIN="$PHP_BIN" SHOPRO_COMPOSER_BIN="$COMPOSER_BIN" SHOPRO_DEPLOY_ENV="$DEPLOY_ENV" bash bin/sync-installed-modules

echo "[Shopro] Installing Composer dependencies"
# On Plesk, `composer` can be a phpenv shell shim rather than a PHP/PHAR file.
# It must therefore be executed directly instead of being passed to PHP.
# Symfony auto-scripts may boot the new application. They must not run before
# migrations required by that version of the code have completed.
COMPOSER_FLAGS=(--prefer-dist --no-interaction --no-progress --no-scripts)
if [ "$DEPLOY_ENV" = "prod" ]; then
    COMPOSER_FLAGS+=(--no-dev --classmap-authoritative)
fi
"$COMPOSER_BIN" install "${COMPOSER_FLAGS[@]}"

if [ ! -f vendor/symfony/html-sanitizer/HtmlSanitizer.php ]; then
    echo "[Shopro] Composer did not install symfony/html-sanitizer" >&2
    exit 1
fi

# Composer path repositories may have just replaced an installed module with a
# newer revision. Refresh the container and route cache immediately so a later,
# unrelated deployment step cannot leave the web runtime on the previous module
# route map.
echo "[Shopro] Refreshing application cache after package synchronization"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console cache:clear

if APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console doctrine:migrations:up-to-date --no-interaction >/dev/null 2>&1; then
    echo "[Shopro] Database is up to date; pre-migration backup is not required"
else
    echo "[Shopro] Creating pre-migration backup"
    APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" bash bin/create-backup
fi

echo "[Shopro] Running database migrations"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console doctrine:migrations:migrate --no-interaction

echo "[Shopro] Validating Doctrine mapping"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console doctrine:schema:validate --skip-sync

echo "[Shopro] Synchronizing system translations"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console app:translations:sync

echo "[Shopro] Synchronizing module registry"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console app:modules:sync

echo "[Shopro] Verifying module registry"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console app:modules:verify

echo "[Shopro] Synchronizing required system pages"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console app:pages:install-system

echo "[Shopro] Synchronizing active theme content"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console app:themes:sync-content

echo "[Shopro] Installing bundle assets"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console assets:install public

echo "[Shopro] Installing importmap vendor assets"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console importmap:install

# AssetMapper does not replace changed compiled assets reliably in debug mode.
# This directory contains generated files only; source assets live in /assets.
echo "[Shopro] Removing previously compiled AssetMapper files"
if [ -d public/assets ]; then
    find public/assets -mindepth 1 -depth -delete
fi

echo "[Shopro] Compiling AssetMapper assets"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console asset-map:compile

if ! grep -q '"rich-editor"' public/assets/importmap.json || ! grep -q '"admin-form-components.js"' public/assets/manifest.json; then
    echo "[Shopro] Required newsletter form assets are missing from the compiled import map" >&2
    exit 1
fi
SELECT_STYLE_ASSET="$("$PHP_BIN" -r '$manifest = json_decode(file_get_contents("public/assets/manifest.json"), true, 512, JSON_THROW_ON_ERROR); echo $manifest["styles/admin-select.css"] ?? "";')"
if [ -z "$SELECT_STYLE_ASSET" \
    ] || [ ! -f "public$SELECT_STYLE_ASSET" \
    ] || ! grep -q 'ui-searchable-select__dropdown' "public$SELECT_STYLE_ASSET"; then
    echo "[Shopro] The compiled stylesheet does not contain the shared SearchableSelect component" >&2
    exit 1
fi

echo "[Shopro] Generating responsive image variants"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" -d memory_limit=512M bin/console app:images:optimize \
    || echo "[Shopro] Image variants could not be fully regenerated; original uploads remain available"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" -d memory_limit=512M bin/console app:theme-images:optimize \
    || echo "[Shopro] Theme image variants could not be fully regenerated; original theme assets remain available"

# Cache must be cleared after compilation so that Symfony discovers the
# freshly generated manifest instead of retaining old asset URLs.
echo "[Shopro] Clearing Symfony cache"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console cache:clear

echo "[Shopro] Ensuring newsletter queue worker is scheduled"
SHOPRO_DEPLOY_ENV="$DEPLOY_ENV" SHOPRO_DEPLOY_DEBUG="$DEPLOY_DEBUG" bash bin/setup-queue-worker --install-only || echo "[Shopro] Cron unavailable; configure the worker in Plesk Scheduled Tasks"
echo "[Shopro] Processing messages already waiting in the queue"
SHOPRO_DEPLOY_ENV="$DEPLOY_ENV" SHOPRO_DEPLOY_DEBUG="$DEPLOY_DEBUG" bash bin/setup-queue-worker --drain-only || echo "[Shopro] Queue is already being processed or the mail transport needs attention"
echo "[Shopro] Removing resolved newsletter messages from the failure transport"
APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" "$PHP_BIN" bin/console app:newsletter:reconcile-failed || echo "[Shopro] Failure transport reconciliation needs manual review"

echo "[Shopro] Running final runtime readiness check"
SHOPRO_PHP_BIN="$PHP_BIN" APP_ENV="$DEPLOY_ENV" APP_DEBUG="$DEPLOY_DEBUG" SHOPRO_PUBLIC_RELEASE="${SHOPRO_PUBLIC_RELEASE:-0}" bash bin/release-check --runtime

echo "[Shopro] $DEPLOY_ENV deployment completed"
