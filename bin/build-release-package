#!/usr/bin/env bash

set -Eeuo pipefail

trap 'status=$?; echo "[Shopro package] Failed at line $LINENO (exit $status)" >&2; exit $status' ERR

cd "$(dirname "$0")/.."

VERSION="${1:-$(git describe --tags --always --dirty 2>/dev/null || echo dev)}"
SAFE_VERSION="$(printf '%s' "$VERSION" | tr -cd 'A-Za-z0-9._-')"
[ -n "$SAFE_VERSION" ] || SAFE_VERSION="dev"

command -v git >/dev/null 2>&1 || { echo "[Shopro package] git is required." >&2; exit 1; }
command -v composer >/dev/null 2>&1 || { echo "[Shopro package] Composer is required." >&2; exit 1; }
command -v zip >/dev/null 2>&1 || { echo "[Shopro package] zip is required." >&2; exit 1; }

STAGING="$(mktemp -d)"
trap 'rm -rf "$STAGING"' EXIT
PACKAGE_ROOT="$STAGING/shopro"
mkdir -p "$PACKAGE_ROOT" dist

echo "[Shopro package] Exporting tracked source files"
git archive HEAD | tar -x -C "$PACKAGE_ROOT"

# The source checkout defaults to dev for local development. A production
# package cannot use that default because require-dev packages (including
# DebugBundle) are intentionally absent. The installer replaces these values
# with the final, secret configuration after validating the server.
sed -i 's/^APP_ENV=.*/APP_ENV=prod/' "$PACKAGE_ROOT/.env"

echo "[Shopro package] Installing production dependencies"
(
    cd "$PACKAGE_ROOT"
    composer install --no-dev --classmap-authoritative --prefer-dist --no-interaction --no-progress --no-scripts
    mkdir -p var/cache var/log var/backups public/uploads

    export APP_ENV=prod
    export APP_DEBUG=0
    export APP_SECRET=release-build-placeholder
    export DATABASE_URL='mysql://placeholder:placeholder@127.0.0.1:3306/placeholder?serverVersion=10.6.0-MariaDB&charset=utf8mb4'
    export MESSENGER_TRANSPORT_DSN='doctrine://default?auto_setup=0'
    export MAILER_DSN='null://null'

    php bin/console assets:install public
    php bin/console importmap:install
    php bin/console asset-map:compile
    rm -rf var/cache/*
)

ARCHIVE="$(pwd)/dist/shopro-${SAFE_VERSION}.zip"
rm -f "$ARCHIVE"
echo "[Shopro package] Creating $ARCHIVE"
(
    cd "$PACKAGE_ROOT"
    zip -qr "$ARCHIVE" . \
        -x '.env.local' '.env.*.local' 'tests/*' '.github/*' '.git/*' \
        'var/cache/*' 'var/log/*' 'var/backups/*'
)

echo "[Shopro package] Ready: $ARCHIVE"
